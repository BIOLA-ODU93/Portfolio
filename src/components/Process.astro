---
import { process } from '../content/site';
import { rich, pad } from '../lib/format';
import Chapter from './Chapter.astro';
---

<section id="process" class="section process" data-theme="paper" data-chapter="4" data-chapter-label="How I work" aria-labelledby="process-title">
  <div class="wrap">
    <div class="grid process__intro">
      <div class="process__heading">
        <Chapter n={4} label="How I work" />
        <h2 id="process-title" class="h-section" data-reveal set:html={rich(process.title)} />
      </div>
      <p class="lede muted process__lede" data-reveal style="--d:1" set:html={rich(process.intro)} />
    </div>

    <ol class="steps">
      {
        process.steps.map((step, i) => (
          <li class="step" data-reveal style={`--d:${i}`}>
            <span class="step__pin" aria-hidden="true" />
            <span class="label step__n">Step {pad(i + 1)}</span>
            <h3 class="step__name">{step.name}</h3>
            <p class="step__body muted" set:html={rich(step.body)} />
            <dl class="step__meta">
              <div>
                <dt class="label muted">Together</dt>
                <dd set:html={rich(step.together)} />
              </div>
              <div>
                <dt class="label muted">Outcome</dt>
                <dd set:html={rich(step.output)} />
              </div>
            </dl>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process__intro { row-gap: 32px; align-items: end; }
  .process__heading, .process__lede { grid-column: 1 / -1; }
  @media (min-width: 960px) {
    .process__heading { grid-column: 1 / span 7; }
    .process__lede { grid-column: 9 / -1; }
  }

  .steps {
    position: relative;
    display: grid;
    gap: 0;
    margin-top: clamp(56px, 8vw, 120px);
    counter-reset: step;
  }
  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 0 0 48px 40px;
    border-left: 1px solid var(--line);
  }
  .step:last-child { padding-bottom: 0; }
  .step__pin {
    position: absolute;
    left: -6px;
    top: 4px;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--fg);
    transition: background 0.3s, border-color 0.3s, transform 0.4s var(--ease-out);
  }
  .step:hover .step__pin { background: var(--pin); border-color: var(--pin); transform: scale(1.3); }
  .step__n { color: var(--accent-text); }
  .step__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--type-h4);
    line-height: 1.05;
  }
  .step__body { max-width: 40ch; }
  .step__meta {
    display: grid;
    gap: 14px;
    margin-top: 10px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: var(--type-small);
    line-height: 1.45;
  }
  .step__meta div { display: grid; gap: 4px; }

  @media (min-width: 700px) and (max-width: 1099px) {
    .steps { grid-template-columns: repeat(2, 1fr); column-gap: var(--gutter); row-gap: 56px; }
    .step { padding-bottom: 0; }
  }

  /* Desktop: a horizontal route with five waypoints */
  @media (min-width: 1100px) {
    .steps {
      grid-template-columns: repeat(5, 1fr);
      column-gap: clamp(20px, 2vw, 36px);
      padding-top: 40px;
      border-top: 1px solid var(--line);
    }
    .step { padding: 0; border-left: 0; }
    .step__pin { left: 0; top: -46px; }
  }
</style>
