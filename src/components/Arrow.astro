---
interface Props { dir?: 'right' | 'down' | 'up-right' | 'up' }
const { dir = 'right' } = Astro.props;
const rot = { right: 0, down: 90, 'up-right': -45, up: -90 }[dir];
---
<svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
  <g transform={`rotate(${rot} 8 8)`}>
    <path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.4" />
  </g>
</svg>
