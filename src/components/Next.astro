---
import { next } from '../content/site';
import { rich } from '../lib/format';
import Chapter from './Chapter.astro';
---

<section id="next" class="section next grain" data-theme="ink" data-chapter="5" data-chapter-label="What’s next" aria-labelledby="next-title">
  <!-- The route continues: solid = the path so far, dashed = the road ahead -->
  <svg class="next__road" viewBox="0 0 1600 200" preserveAspectRatio="none" aria-hidden="true">
    <path class="next__solid" d="M-10 150 C 300 150, 420 60, 700 90" vector-effect="non-scaling-stroke" />
    <path class="next__dashed" d="M700 90 C 980 120, 1200 40, 1620 60" vector-effect="non-scaling-stroke" />
  </svg>
  <span class="next__here label" aria-hidden="true"><span class="next__here-dot"></span><span class="next__here-text">You are here</span></span>

  <div class="wrap grid">
    <div class="next__main">
      <Chapter n={5} label="What’s next" />
      <h2 id="next-title" class="next__title display" data-reveal set:html={rich(next.title)} />
    </div>

    <div class="next__copy">
      {next.body.map((p, i) => <p data-reveal style={`--d:${i}`} set:html={rich(p)} />)}
      <p class="next__open label" data-reveal set:html={rich(next.openTo)} />
    </div>

    <div class="next__exploring" data-reveal>
      <h3 class="label muted">Currently exploring</h3>
      <ul>
        {next.exploring.map((e) => <li set:html={rich(e)} />)}
      </ul>
    </div>
  </div>
</section>

<style>
  .next { overflow: hidden; padding-top: calc(var(--section-y) + 80px); }
  .next__road {
    position: absolute;
    top: clamp(24px, 4vw, 60px);
    left: 0;
    width: 100%;
    height: 120px;
    fill: none;
  }
  .next__solid { stroke: var(--pin); stroke-width: 1.5; }
  .next__dashed { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 4 7; }
  .next__here {
    position: absolute;
    top: calc(clamp(24px, 4vw, 60px) + 54px - 6px);
    left: 43.75%;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
  }
  .next__here-text { transform: translateY(-22px); }
  .next__here-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--pin);
    box-shadow: 0 0 0 6px rgba(159, 191, 212, 0.18);
    margin-left: -6px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .next__here-text { transform: translateY(-22px); }
  .next__here-dot { animation: pulse 2.4s var(--ease-in-out) infinite; }
  }
  @keyframes pulse {
    50% { box-shadow: 0 0 0 12px rgba(159, 191, 212, 0); }
  }

  .next__main { grid-column: 1 / -1; }
  .next__title {
    font-size: var(--type-h2);
    max-width: 12ch;
    text-wrap: balance;
  }
  .next__title :global(em) { color: var(--pin); }
  .next__copy {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.1em;
    margin-top: clamp(40px, 6vw, 80px);
    font-size: var(--type-lede);
    line-height: 1.5;
    max-width: 40ch;
  }
  .next__open {
    margin-top: 12px;
    color: var(--pin);
  }
  .next__exploring {
    grid-column: 1 / -1;
    margin-top: clamp(40px, 6vw, 80px);
  }
  .next__exploring ul {
    margin-top: 16px;
    border-top: 1px solid var(--line);
  }
  .next__exploring li {
    padding-block: 14px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: var(--type-lede);
  }
  @media (min-width: 960px) {
    .next__copy { grid-column: 1 / span 6; }
    .next__exploring { grid-column: 8 / -1; align-self: end; }
  }
  @media (max-width: 640px) {
    .next__here { left: auto; right: var(--gutter); }
    .next__here-text { transform: translateY(-22px); }
  .next__here-dot { display: none; }
  }
</style>
