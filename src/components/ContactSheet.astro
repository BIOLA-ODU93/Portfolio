---
/**
 * "Let's talk" — a small panel with three ways to reach Biola: email, call, WhatsApp.
 * Any element with [data-contact-open] opens it. Details live in site.ts (`site`).
 */
import { site } from '../content/site';

const tel = 'tel:' + site.phone.replace(/[^+\d]/g, '');
const wa = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappMessage)}`;
const mail = `mailto:${site.email}?subject=${encodeURIComponent('Hello from your portfolio')}`;
---

<dialog class="talk" id="talk" aria-labelledby="talk-title" data-talk>
  <div class="talk__panel">
    <header class="talk__head">
      <div>
        <p class="label talk__kicker">Let’s talk</p>
        <h2 id="talk-title" class="talk__title">How would you like to <em>reach me?</em></h2>
      </div>
      <button class="talk__close" type="button" data-talk-close aria-label="Close">✕</button>
    </header>

    <ul class="talk__list">
      <li>
        <a class="talk__opt" href={mail}>
          <span class="talk__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5 12 13l8.5-6.5" /></svg>
          </span>
          <span class="talk__text"><span class="talk__name">Email</span><span class="talk__detail">{site.email}</span></span>
          <span class="talk__arrow" aria-hidden="true">↗</span>
        </a>
        <button class="talk__copy label" type="button" data-copy={site.email}>Copy</button>
      </li>
      <li>
        <a class="talk__opt" href={tel}>
          <span class="talk__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg>
          </span>
          <span class="talk__text"><span class="talk__name">Call</span><span class="talk__detail">{site.phone}</span></span>
          <span class="talk__arrow" aria-hidden="true">↗</span>
        </a>
      </li>
      <li>
        <a class="talk__opt" href={wa} target="_blank" rel="noopener noreferrer">
          <span class="talk__icon talk__icon--wa" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z" /><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8a5 5 0 0 1-2.8-2.8l.8-1-1-2z" /></svg>
          </span>
          <span class="talk__text"><span class="talk__name">WhatsApp</span><span class="talk__detail">Chat with me</span></span>
          <span class="talk__arrow" aria-hidden="true">↗</span>
          <span class="visually-hidden">(opens WhatsApp)</span>
        </a>
      </li>
    </ul>

    <p class="talk__foot">Based in Dublin (GMT/IST)</p>
    <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
  </div>
</dialog>

<style>
  .talk {
    width: min(460px, calc(100% - 24px));
    max-width: none; /* browsers cap dialog width by default */
    max-height: none;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: transparent;
    color: var(--fog);
    opacity: 0;
    transform: translateY(14px) scale(0.98);
    transition: opacity 0.45s var(--ease-out), transform 0.55s var(--ease-out);
  }
  .talk::backdrop { background: rgba(10, 8, 6, 0.6); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); opacity: 0; transition: opacity 0.45s var(--ease-out); }
  .talk:global(.is-in) { opacity: 1; transform: none; }
  .talk:global(.is-in)::backdrop { opacity: 1; }
  .talk__panel {
    padding: clamp(20px, 3vw, 28px);
    background: var(--night-2);
    border: 1px solid rgba(208, 197, 171, 0.14);
    border-radius: 14px;
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7);
  }
  .talk__head { display: flex; justify-content: space-between; align-items: start; gap: 16px; margin-bottom: 20px; }
  .talk__kicker { color: var(--mist); }
  .talk__title { margin: 8px 0 0; font-family: var(--font-display); font-weight: var(--fw-display); font-size: var(--fs-3); line-height: 1.05; letter-spacing: var(--tracking-display); }
  .talk__title em { font-style: normal; color: var(--accent); }
  .talk__close {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(208, 197, 171, 0.25);
    transition: background 0.3s, color 0.3s;
  }
  .talk__close:hover { background: var(--fog); color: var(--night); }

  .talk__list { display: grid; gap: 8px; }
  .talk__list li { display: flex; gap: 8px; align-items: stretch; }
  .talk__opt {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 64px;
    padding: 10px 16px 10px 10px;
    border-radius: 10px;
    background: rgba(208, 197, 171, 0.04);
    border: 1px solid rgba(208, 197, 171, 0.1);
    transition: background 0.3s, border-color 0.3s, transform 0.4s var(--ease-out);
  }
  .talk__opt:hover { background: rgba(208, 197, 171, 0.09); border-color: rgba(208, 197, 171, 0.3); transform: translateX(2px); }
  .talk__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--fog);
    color: var(--night);
  }
  .talk__icon svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; }
  .talk__icon--wa { background: #25d366; color: #06231a; }
  .talk__text { display: grid; gap: 2px; min-width: 0; }
  .talk__name { font-family: var(--font-display); font-weight: 500; font-size: var(--fs-1); line-height: 1.1; letter-spacing: -0.02em; }
  .talk__detail { font-size: var(--type-small); color: rgba(208, 197, 171, 0.65); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .talk__arrow { margin-left: auto; color: rgba(208, 197, 171, 0.6); }
  .talk__copy {
    flex: none;
    padding: 0 14px;
    border-radius: 10px;
    border: 1px solid rgba(208, 197, 171, 0.14);
    transition: background 0.3s, color 0.3s;
  }
  .talk__copy:hover { background: var(--fog); color: var(--night); }
  .talk__foot { margin: 18px 0 0; font-size: var(--type-small); color: rgba(208, 197, 171, 0.55); }

  @media (max-width: 520px) {
    .talk { position: fixed; inset: auto 0 0 0; margin: 0; width: 100%; border-radius: 16px 16px 0 0; }
    .talk__panel { border-radius: 16px 16px 0 0; padding-bottom: calc(20px + env(safe-area-inset-bottom)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .talk { transform: none; }
  }
</style>

<script>
  const talk = document.querySelector<HTMLDialogElement>('[data-talk]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (talk) {
    const open = () => {
      if (talk.open) return;
      document.querySelector<HTMLDialogElement>('dialog[open]:not([data-talk])')?.close(); // e.g. the menu
      talk.showModal();
      requestAnimationFrame(() => requestAnimationFrame(() => talk.classList.add('is-in')));
    };
    const close = () => {
      talk.classList.remove('is-in');
      setTimeout(() => talk.close(), reduce ? 0 : 400);
    };
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest('[data-contact-open]');
      if (t) { e.preventDefault(); open(); }
    });
    talk.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    talk.addEventListener('click', (e) => { if (e.target === talk) close(); }); // click outside the panel
    talk.querySelector('[data-talk-close]')?.addEventListener('click', close);
    talk.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
      b.addEventListener('click', async () => {
        const status = talk.querySelector('[data-copy-status]');
        try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); b.textContent = 'Copied'; if (status) status.textContent = 'Email address copied'; }
        catch { b.textContent = '⌘C'; }
        setTimeout(() => (b.textContent = 'Copy'), 1800);
      }),
    );
  }
</script>
