---
/**
 * The Journey — a real map, driven by scroll.
 * A danfo drives the Nigeria stops, a plane flies Lagos → Dublin, a car drives
 * Dublin. Cards show the years, role and results at each stop.
 * Copy: src/content/site.ts (`journey`). Engine: src/scripts/journey.ts.
 */
import 'maplibre-gl/dist/maplibre-gl.css';
import { journey } from '../content/site';

const pad = (n: number) => String(n).padStart(2, '0');
const rich = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\[(.+?)\]/g, '<span class="ph">$1</span>');
---

<section id="journey" class="journey" aria-labelledby="journey-title" data-journey style={`--stops:${journey.stops.length}`}>
  <div class="journey__stage">
    <div class="journey__map" data-jmap aria-hidden="true"></div>
    <div class="journey__fog" aria-hidden="true"></div>

    <div class="journey__intro" data-jintro>
      <p class="label journey__kicker">{journey.kicker}</p>
      <h2 id="journey-title" class="journey__title">{journey.title}</h2>
      <p class="journey__lede">{journey.intro}</p>
    </div>

    <ol class="jcards">
      {
        journey.stops.map((s, i) => (
          <li class="jcard" data-jcard={i}>
            <p class="label jcard__when">
              <span class="jcard__n">{pad(i + 1)}</span>
              <span class="jcard__rule" aria-hidden="true" />
              <span set:html={rich(s.when)} />
            </p>
            <h3 class="jcard__title">{s.title}</h3>
            <p class="jcard__role">{s.role} · <span set:html={rich(s.place)} /></p>
            <ul class="jcard__points">{s.points.map((pt) => <li set:html={rich(pt)} />)}</ul>
            {s.metrics && (
              <ul class="jcard__metrics" aria-label="Results">{s.metrics.map((m) => <li>{m}</li>)}</ul>
            )}
            {s.links && (
              <ul class="jcard__links">
                {s.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} ↗</a></li>)}
              </ul>
            )}
          </li>
        ))
      }
    </ol>

    <nav class="jnav" aria-label="Journey stops">
      <ol>
        {
          journey.stops.map((s, i) => (
            <li>
              <button type="button" data-jgoto={i + 1}>
                <span class="jnav__when" set:html={rich(s.when)} />
                <span class="jnav__title">{s.title}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </nav>

    <p class="journey__hint label" data-jhint>Scroll to travel ↓</p>
  </div>
</section>

<script type="application/json" id="journey-data" set:html={JSON.stringify(journey.stops)} />

<style>
  .journey {
    position: relative;
    height: calc(100svh + var(--stops) * 100svh);
    background: var(--night);
    color: var(--fog);
  }
  .journey__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .journey__map { position: absolute; inset: 0; background: var(--night); }
  .journey__map :global(.maplibregl-ctrl-attrib) {
    background: rgba(12, 16, 20, 0.6);
    color: rgba(232, 236, 238, 0.6);
    font: 400 10px/1.4 var(--font-sans);
  }
  .journey__map :global(.maplibregl-ctrl-attrib a) { color: inherit; }
  .journey__map :global(.maplibregl-ctrl-attrib-button) { filter: invert(1); }

  .journey__fog {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, var(--night), rgba(12, 16, 20, 0) 16%),
      linear-gradient(to top, rgba(12, 16, 20, 0.85), rgba(12, 16, 20, 0) 30%),
      radial-gradient(130% 100% at 60% 45%, transparent 55%, rgba(12, 16, 20, 0.7));
  }

  /* ── Stop pins (MapLibre markers; styled globally since they're injected). Vehicles are 3D — see journey-vehicles.ts */
  :global(.jstop) { pointer-events: none; }
  :global(.jstop__dot) {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid #e8ecee;
    background: rgba(12, 16, 20, 0.7);
    position: relative;
  }
  :global(.jstop__dot::before), :global(.jstop__dot::after) {
    content: ''; position: absolute; left: 50%; top: 50%; background: #e8ecee; transform: translate(-50%, -50%);
  }
  :global(.jstop__dot::before) { width: 6px; height: 1.5px; }
  :global(.jstop__dot::after) { width: 1.5px; height: 6px; }
  :global(.jstop__label) {
    position: absolute; left: 50%; bottom: 22px; translate: -50% 0;
    white-space: nowrap; font: 500 11px/1 var(--font-sans); letter-spacing: 0.16em; text-transform: uppercase;
    color: #e8ecee; text-shadow: 0 1px 8px rgba(0, 0, 0, 0.95);
    opacity: 0; transition: opacity 0.35s;
  }
  :global(.jstop.is-active .jstop__label) { opacity: 1; }
  :global(.jstop.is-active .jstop__dot) { background: #e8ecee; }
  :global(.jstop.is-active .jstop__dot::before), :global(.jstop.is-active .jstop__dot::after) { background: var(--night); }

  /* ── Overview title ── */
  .journey__intro {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    padding: var(--gutter);
    text-align: center;
    pointer-events: none;
    background: radial-gradient(60% 50% at 50% 50%, rgba(12, 16, 20, 0.65), transparent 75%);
  }
  .journey__kicker { color: var(--mist); }
  .journey__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--fs-7);
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .journey__lede { max-width: 42ch; color: rgba(232, 236, 238, 0.75); font-size: var(--type-small); }

  /* ── Cards ── */
  .jcards {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(28px, 5vh, 48px);
    width: min(440px, calc(100% - 2 * var(--gutter)));
    pointer-events: none;
  }
  .jcard {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    display: grid;
    gap: 10px;
    padding: clamp(18px, 2.2vw, 28px);
    background: rgba(12, 16, 20, 0.8);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(232, 236, 238, 0.14);
    border-radius: 4px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    transition: opacity 0.45s var(--ease-out), transform 0.55s var(--ease-out), visibility 0s linear 0.55s;
  }
  .jcard.is-active { opacity: 1; visibility: visible; transform: none; pointer-events: auto; transition-delay: 0s; }
  .jcard__when { display: flex; align-items: center; gap: 12px; color: var(--mist); }
  .jcard__n { color: var(--fog); }
  .jcard__rule { width: 28px; height: 1px; background: rgba(232, 236, 238, 0.3); }
  .jcard__title { margin: 0; font-family: var(--font-display); font-weight: 300; font-size: var(--fs-4); line-height: 1; }
  .jcard__role { margin: 0; font-size: var(--type-small); color: rgba(232, 236, 238, 0.8); }
  .jcard__points { display: grid; gap: 6px; font-size: var(--type-small); line-height: 1.5; color: rgba(232, 236, 238, 0.72); }
  .jcard__points li { position: relative; padding-left: 16px; }
  .jcard__points li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 8px; height: 1px; background: var(--mist); }
  .jcard__metrics { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .jcard__metrics li { padding: 6px 12px; border-radius: 999px; background: #e8ecee; color: var(--night); font-size: 12px; font-weight: 500; }
  .jcard__links { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: var(--type-small); }
  .jcard__links a { border-bottom: 1px solid rgba(232, 236, 238, 0.4); }
  .jcard__links a:hover { color: var(--accent); border-color: var(--accent); }

  /* ── Year index ── */
  .jnav {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    padding: 10px 14px;
    background: rgba(12, 16, 20, 0.6);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-radius: 4px;
  }
  .jnav ol { display: grid; gap: 0; border-left: 1px solid rgba(232, 236, 238, 0.18); }
  .jnav button {
    display: grid;
    gap: 1px;
    text-align: left;
    padding: 5px 0 5px 14px;
    margin-left: -1px;
    border-left: 1px solid transparent;
    color: rgba(232, 236, 238, 0.5);
    transition: color 0.3s, border-color 0.3s;
  }
  .jnav button:hover,
  .jnav button[aria-current='true'] { color: var(--fog); border-left-color: var(--fog); }
  .jnav__when { font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; }
  .jnav__title { font-family: var(--font-display); font-size: 16px; line-height: 1.1; }

  .journey__hint {
    position: absolute;
    left: 50%;
    bottom: clamp(28px, 5vh, 48px);
    translate: -50% 0;
    color: rgba(232, 236, 238, 0.7);
  }
  .ph { outline: 1px dashed currentColor; outline-offset: 2px; }

  /* No WebGL / map failed: show the journey as a simple list */
  .journey:global(.is-static) { height: auto; }
  .journey:global(.is-static) .journey__stage { position: relative; height: auto; overflow: visible; padding: 120px var(--gutter); }
  .journey:global(.is-static) :is(.journey__map, .journey__fog, .jnav, .journey__hint) { display: none; }
  .journey:global(.is-static) .journey__intro { position: relative; background: none; }
  .journey:global(.is-static) .jcards { position: relative; left: 0; bottom: 0; width: auto; display: grid; gap: 16px; max-width: 640px; margin: 48px auto 0; }
  .journey:global(.is-static) .jcard { position: relative; opacity: 1; visibility: visible; transform: none; }

  @media (max-width: 900px) {
    .jnav { display: none; }
  }
</style>

<script>
  import { initJourney } from '../scripts/journey';
  initJourney();
</script>
