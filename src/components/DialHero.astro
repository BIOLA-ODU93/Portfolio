---
/**
 * 01 · Opening — the adire dial.
 *
 * A medallion of ten wedges (the five sections, twice round). Drag it,
 * tap a wedge, or use ← → to turn; ENTER goes to the section on top.
 * Geometry is in viewBox units (centre 0,0); copy lives in site.ts (`dial`).
 */
import { dial } from '../content/site';
import { pad } from '../lib/format';
import Arrow from './Arrow.astro';

const R = 470; // outer radius of the wedges
const r0 = 140; // inner radius (hub cut-out)
const N = 10; // wedges round the circle
const step = 360 / N;
const rad = (a: number) => (a * Math.PI) / 180;
const p = (r: number, a: number) => `${(r * Math.cos(rad(a))).toFixed(1)} ${(r * Math.sin(rad(a))).toFixed(1)}`;

const wedges = Array.from({ length: N }, (_, i) => {
  const mid = -90 + i * step;
  const a0 = mid - step / 2;
  const a1 = mid + step / 2;
  const d = `M${p(r0, a0)} L${p(R, a0)} A${R} ${R} 0 0 1 ${p(R, a1)} L${p(r0, a1)} A${r0} ${r0} 0 0 0 ${p(r0, a0)} Z`;
  return { i, mid, d, section: dial.sections[i % dial.sections.length] };
});

const ticks = Array.from({ length: 180 }, (_, i) => {
  const a = i * 2;
  return `M${p(R + 12, a)} L${p(R + (i % 5 ? 22 : 34), a)}`;
}).join(' ');

// Motifs drawn around 0,0 (≈60 units radius) — original adire-inspired marks
const motif = (k: string) => {
  if (k === 'rings') return [14, 28, 42, 56].map((r) => `<circle r="${r}"/>`).join('');
  if (k === 'sun') {
    let g = '<circle r="14"/>';
    for (let i = 0; i < 16; i++) { const a = (i * Math.PI) / 8; g += `<path d="M${(22 * Math.cos(a)).toFixed(1)} ${(22 * Math.sin(a)).toFixed(1)} L${(58 * Math.cos(a)).toFixed(1)} ${(58 * Math.sin(a)).toFixed(1)}"/>`; }
    return g;
  }
  if (k === 'leaf') {
    let g = '<path d="M0 -60 L0 60"/>';
    for (let i = 0; i < 6; i++) { const y = -44 + i * 18; g += `<path d="M0 ${y + 12} Q-24 ${y + 4} -42 ${y - 10}"/><path d="M0 ${y + 12} Q24 ${y + 4} 42 ${y - 10}"/>`; }
    return g;
  }
  if (k === 'grid') {
    let g = '';
    for (let i = -2; i <= 2; i++) g += `<path d="M${i * 22} -50 L${i * 22} 50"/><path d="M-50 ${i * 22} L50 ${i * 22}"/>`;
    return g;
  }
  let d = '';
  for (let i = 0; i <= 160; i++) { const a = i * 0.17, r = 2 + i * 0.34; d += (i ? 'L' : 'M') + (r * Math.cos(a)).toFixed(1) + ' ' + (r * Math.sin(a)).toFixed(1); }
  return `<path d="${d}"/>`;
};

const first = dial.sections[0];
---

<section id="top" class="dial-hero" data-theme="ink" data-chapter="1" data-chapter-label="Opening" aria-labelledby="dial-title" data-dial-hero>
  <div class="dial-hero__copy">
    <h1 id="dial-title" class="dial-hero__title">
      <span class="visually-hidden">Biola Odu — </span>
      <img class="dial-hero__script" src={dial.scriptWord.src} alt={dial.scriptWord.alt} width="165" height="94" />
      <span class="dial-hero__caps">{dial.headline}</span>
    </h1>

    <p class="dial-hero__hint label">
      <button type="button" class="dial-hero__step" data-dial-prev aria-label="Turn the dial left">←</button>
      <span>{dial.hint}</span>
      <button type="button" class="dial-hero__step" data-dial-next aria-label="Turn the dial right">→</button>
    </p>
    <p class="dial-hero__now" aria-live="polite" data-dial-now>
      <span data-dial-n>01</span> · <em data-dial-label>{first.label}</em> — <span data-dial-blurb>{first.blurb}</span>
    </p>
  </div>

  <div class="dial" data-dial>
    <svg
      class="dial__svg"
      viewBox="-720 -720 1440 1440"
      role="slider"
      tabindex="0"
      aria-label="Choose a section"
      aria-valuemin="1"
      aria-valuemax={dial.sections.length}
      aria-valuenow="1"
      aria-valuetext={first.label}
      data-dial-svg
    >
      <defs>
        <radialGradient id="dial-glow" cx="0" cy="0" r="720" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#9fbfd4" stop-opacity="0.16" />
          <stop offset="1" stop-color="#9fbfd4" stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle r="720" fill="url(#dial-glow)" />
      <circle class="dial__ring" r={R + 70} />
      <circle class="dial__ring dial__ring--dash" r={R + 140} />
      <circle class="dial__ring dial__ring--faint" r={R + 230} />

      <g class="dial__rotor" data-dial-rotor>
        <path class="dial__ticks" d={ticks} />
        {
          wedges.map((w) => (
            <g class="dial__wedge" data-wedge={w.i}>
              <path class="dial__wedge-shape" d={w.d} />
              <g class="dial__motif" transform={`rotate(${w.mid + 90}) translate(0 -300)`} set:html={motif(w.section.motif)} />
              <text class="dial__label" transform={`rotate(${w.mid + 90}) translate(0 -412)`} text-anchor="middle">
                {w.section.label.toUpperCase()}
              </text>
            </g>
          ))
        }
      </g>
      <path class="dial__pointer" d={`M-11 ${-R - 52} L11 ${-R - 52} L0 ${-R - 34} Z`} />
    </svg>

    <button type="button" class="dial__hub" data-dial-enter>
      <span class="dial__count label"><span data-dial-count>01</span> / {pad(dial.sections.length)}</span>
      <span class="dial__enter">Enter</span>
      <span class="visually-hidden" data-dial-enter-label>{first.label}</span>
    </button>
  </div>
</section>

<style>
  .dial-hero {
    --D: min(max(780px, 100vw), 1440px, 160svh);
    position: relative;
    height: 100svh;
    min-height: 640px;
    overflow: hidden;
    isolation: isolate;
  }

  /* ── Copy ── */
  .dial-hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: clamp(6px, 1.2vh, 12px);
    padding: calc(var(--header-h) + clamp(0px, 2vh, 24px)) var(--gutter) 0;
    text-align: center;
    pointer-events: none;
  }
  .dial-hero__copy button { pointer-events: auto; }
  .dial-hero__title {
    display: grid;
    justify-items: center;
    margin: 0;
    font-weight: 300;
  }
  .dial-hero__script {
    width: clamp(112px, 11.5vw, 170px);
    height: auto;
    margin-bottom: -0.35em;
  }
  .dial-hero__caps {
    font-family: var(--font-display);
    font-size: var(--fs-4);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .dial-hero__hint {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: clamp(8px, 2vh, 20px);
    color: var(--accent);
  }
  .dial-hero__step {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 14px;
    transition: background 0.3s, color 0.3s;
  }
  .dial-hero__step:hover { background: var(--accent); color: var(--night); }
  .dial-hero__now {
    font-family: var(--font-display);
    font-size: var(--fs-1);
    color: color-mix(in srgb, var(--fg) 85%, transparent);
  }
  .dial-hero__now em { font-style: italic; }

  /* ── Dial ── */
  .dial {
    position: absolute;
    left: 50%;
    bottom: calc(8px - var(--D) / 2);
    width: var(--D);
    aspect-ratio: 1;
    translate: -50% 0;
    z-index: 1;
  }
  .dial__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .dial__svg:active { cursor: grabbing; }
  .dial__svg:focus-visible { outline: none; }
  .dial__svg:focus-visible .dial__pointer { fill: var(--accent); }
  .dial__ring { fill: none; stroke: var(--accent); stroke-opacity: 0.14; }
  .dial__ring--dash { stroke-dasharray: 2 8; stroke-opacity: 0.1; }
  .dial__ring--faint { stroke-opacity: 0.06; }
  .dial__ticks { stroke: var(--accent); stroke-opacity: 0.4; fill: none; }
  .dial__wedge-shape {
    fill: #1d2630;
    stroke: var(--accent);
    stroke-opacity: 0.2;
    transition: fill 0.4s var(--ease-out), stroke-opacity 0.4s var(--ease-out);
  }
  .dial__wedge:nth-child(odd) .dial__wedge-shape { fill: #161d24; }
  .dial__wedge.is-active .dial__wedge-shape { fill: #2b3e4d; stroke-opacity: 0.7; }
  .dial__wedge:hover .dial__wedge-shape { stroke-opacity: 0.5; }
  .dial__motif {
    fill: none;
    stroke: var(--accent);
    stroke-opacity: 0.45;
    stroke-width: 1.8;
    stroke-linecap: round;
    transition: stroke 0.4s, stroke-opacity 0.4s;
  }
  .dial__wedge.is-active .dial__motif { stroke: var(--fog); stroke-opacity: 0.95; }
  .dial__label {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    fill: var(--muted);
    transition: fill 0.4s;
  }
  .dial__wedge.is-active .dial__label { fill: var(--fog); }
  .dial__pointer { fill: var(--fog); transition: fill 0.3s; }

  .dial__hub {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--D) * 0.139);
    min-width: 108px;
    aspect-ratio: 1;
    translate: -50% -50%;
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 6px;
    padding-top: calc(var(--D) * 0.014 + 14px);
    border-radius: 50%;
    background: var(--fog);
    color: var(--night);
    box-shadow: 0 0 0 8px rgba(159, 191, 212, 0.55);
    transition: box-shadow 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }
  .dial__hub:hover { box-shadow: 0 0 0 14px rgba(159, 191, 212, 0.45); }
  .dial__hub:focus-visible { outline-offset: 16px; }
  .dial__count { color: var(--muted); --muted: #4f5a63; font-size: 11px; }
  .dial__enter {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .dial-hero__copy { padding-top: calc(var(--header-h) + 24px); }
    /* keep the whole ENTER hub on screen on phones */
    .dial { bottom: calc(120px - var(--D) / 2); }
    .dial__label { font-size: 23px; }
    .dial__motif { stroke-width: 2.6; }
  }
  @media (max-height: 720px) and (min-width: 761px) {
    .dial-hero { --D: min(max(780px, 100vw), 1440px, 150svh); }
    .dial-hero__copy { padding-top: calc(var(--header-h) + 8px); }
  }
</style>
