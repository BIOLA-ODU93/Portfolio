---
/**
 * Hero — built from Figma "Hero — Option A" (Landing Page, node 256:119).
 * Header (Menu · signature · 3D Map), centred headline, floating pill menu.
 */
import { site } from '../content/site';

const links = [
  { label: 'Work', href: '#work' },
  { label: 'About', href: '#about' },
];
const email = site.email.replace(/[[\]]/g, '');
---

<section id="top" class="hero" aria-labelledby="hero-title" data-hero>
  <!-- Portrait: a dark "ghost" (Overlay blend, as in Figma) and the full-colour
       original on top, revealed only inside a spotlight where the cursor touches the body. -->
  <img
    class="portrait portrait--ghost"
    src="/images/portrait@1x.webp"
    srcset="/images/portrait@1x.webp 1x, /images/portrait@2x.webp 2x"
    alt=""
    aria-hidden="true"
    width="812"
    height="977"
    fetchpriority="high"
  />
  <img
    class="portrait portrait--colour"
    src="/images/portrait-colour@1x.webp"
    srcset="/images/portrait-colour@1x.webp 1x, /images/portrait-colour@2x.webp 2x"
    alt=""
    aria-hidden="true"
    width="812"
    height="977"
    data-colour
  />

  <header class="hero__header">
    <button class="hero__menu" type="button" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.5" /></svg>
      <span>Menu</span>
    </button>

    <a class="hero__logo" href="#top">
      <img src="/brand/signature.png" alt={`${site.displayName} — home`} width="115" height="88" />
    </a>

    <button class="hero__map" type="button" data-journey-open aria-haspopup="dialog" aria-controls="journey-map">3D Map</button>
  </header>

  <div class="hero__center">
  <h1 id="hero-title" class="hero__title">
    <span class="visually-hidden">{site.displayName} — </span>
    <img class="hero__script" src="/brand/the-designer-word.png" alt="The Designer" width="301" height="95" />
    <span class="hero__caps">That does more</span>
  </h1>
  <p class="hero__roles">{site.roles}</p>
  </div>

  <nav class="pill" aria-label="Main">
    {links.map((l) => <a class="pill__link" href={l.href}>{l.label}</a>)}
    <a class="pill__cta" href={`mailto:${email}`} data-contact-open>Let’s talk</a>
  </nav>
</section>

<dialog id="site-menu" class="menu" aria-label="Menu" data-menu>
  <button class="menu__close" type="button" data-menu-close>Close</button>
  <nav aria-label="Menu">
    <ol>
      {links.map((l) => <li><a href={l.href} data-menu-link>{l.label}</a></li>)}
      <li><a href={`mailto:${email}`} data-contact-open>Let’s talk</a></li>
    </ol>
  </nav>
</dialog>

<script>
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  document.querySelector('[data-menu-open]')?.addEventListener('click', () => menu?.showModal());
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => menu?.close());
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => menu.close()));

  // ── Portrait: glides toward the mouse, and a spotlight reveals the colour
  // original wherever the cursor is over the body (transparent pixels don't count).
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const colour = document.querySelector<HTMLImageElement>('[data-colour]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && colour) {
    const MAX_X = 28, MAX_Y = 18, MAX_R = 1.6; // drift px, px, lean deg
    const RADIUS = () => Math.max(110, Math.min(200, colour.getBoundingClientRect().width * 0.22));
    const ease = still.matches ? 1 : 0.14;
    let tx = 0, ty = 0, cx = 0, cy = 0, ts = 1, cs = 1; // drift
    let tr = 0, cr = 0, mx = 0, my = 0, cmx = 0, cmy = 0; // spotlight
    let raf = 0;

    // alpha hit-test: is the cursor over the body, not the transparent background?
    const probe = document.createElement('canvas');
    const pctx = probe.getContext('2d', { willReadFrequently: true });
    // copy the image into the probe lazily (the 2x source may swap in after first paint)
    let drawn = '';
    const ensureProbe = () => {
      if (!pctx || !colour.complete || !colour.naturalWidth) return false;
      if (drawn !== colour.currentSrc) {
        probe.width = colour.naturalWidth;
        probe.height = colour.naturalHeight;
        pctx.clearRect(0, 0, probe.width, probe.height);
        pctx.drawImage(colour, 0, 0);
        drawn = colour.currentSrc;
      }
      return true;
    };
    colour.addEventListener('load', () => { drawn = ''; });
    const overBody = (x: number, y: number, b: DOMRect) => {
      if (!ensureProbe() || !pctx) return true;
      const u = Math.floor(((x - b.left) / b.width) * probe.width);
      const v = Math.floor(((y - b.top) / b.height) * probe.height);
      if (u < 0 || v < 0 || u >= probe.width || v >= probe.height) return false;
      return pctx.getImageData(u, v, 1, 1).data[3] > 40;
    };

    const tick = () => {
      cx += (tx - cx) * ease; cy += (ty - cy) * ease; cs += (ts - cs) * ease;
      cr += (tr - cr) * (still.matches ? 1 : 0.18);
      cmx += (mx - cmx) * (still.matches ? 1 : 0.35); cmy += (my - cmy) * (still.matches ? 1 : 0.35);
      if (fine.matches && !still.matches) {
        hero.style.setProperty('--px', `${(cx * MAX_X).toFixed(2)}px`);
        hero.style.setProperty('--py', `${(cy * MAX_Y).toFixed(2)}px`);
        hero.style.setProperty('--pr', `${(cx * MAX_R).toFixed(3)}deg`);
        hero.style.setProperty('--ps', cs.toFixed(4));
      }
      colour.style.setProperty('--r', `${cr.toFixed(1)}px`);
      colour.style.setProperty('--mx', `${cmx.toFixed(1)}px`);
      colour.style.setProperty('--my', `${cmy.toFixed(1)}px`);
      const moving = Math.abs(tx - cx) + Math.abs(ty - cy) + Math.abs(ts - cs) + Math.abs(tr - cr) / 50 + (Math.abs(mx - cmx) + Math.abs(my - cmy)) / 50;
      raf = moving > 0.002 ? requestAnimationFrame(tick) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };

    const aim = (e: PointerEvent) => {
      const h = hero.getBoundingClientRect();
      tx = ((e.clientX - h.left) / h.width) * 2 - 1;
      ty = ((e.clientY - h.top) / h.height) * 2 - 1;
      const b = colour.getBoundingClientRect();
      mx = ((e.clientX - b.left) / b.width) * colour.offsetWidth;
      my = ((e.clientY - b.top) / b.height) * colour.offsetHeight;
      if (!cr) { cmx = mx; cmy = my; } // start the spotlight where the cursor enters
      tr = overBody(e.clientX, e.clientY, b) ? RADIUS() : 0;
    };

    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
      aim(e); ts = 1.02; kick();
    });
    hero.addEventListener('pointerleave', () => { tx = 0; ty = 0; ts = 1; tr = 0; kick(); });

    // Touch: tap the portrait to reveal the colour there for a moment
    let hide = 0;
    hero.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch') return;
      aim(e); kick();
      clearTimeout(hide);
      hide = window.setTimeout(() => { tr = 0; kick(); }, 1600);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    height: 100svh;
    min-height: 560px;
    padding: 0 var(--gutter);
    background: var(--night);
    color: var(--fog);
  }

  /* ── Portrait ──
     Both layers sit directly in the hero (which isolates blending), so the ghost's
     Overlay blend reaches the night background. Motion vars (--px etc.) live on .hero. */
  .hero { isolation: isolate; overflow: hidden; }
  .portrait {
    position: absolute;
    top: 17.7%;
    left: 52.1%;
    height: 108.5%;
    width: auto;
    aspect-ratio: 812 / 977;
    max-width: none;
    translate: -50% 0;
    z-index: -1;
    pointer-events: none;
    user-select: none;
    will-change: transform;
    transform: translate3d(var(--px, 0px), var(--py, 0px), 0) rotate(var(--pr, 0deg)) scale(var(--ps, 1));
  }
  .portrait--ghost { mix-blend-mode: overlay; }
  .portrait--colour {
    /* spotlight: --r is the radius, --mx/--my the centre (px within the image) */
    -webkit-mask-image: radial-gradient(circle at var(--mx, 50%) var(--my, 30%), #000 0, #000 calc(var(--r, 0px) * 0.55), transparent var(--r, 0px));
    mask-image: radial-gradient(circle at var(--mx, 50%) var(--my, 30%), #000 0, #000 calc(var(--r, 0px) * 0.55), transparent var(--r, 0px));
  }

  /* ── Header ── */
  .hero__header {
    position: absolute;
    inset: 0 0 auto 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: clamp(14px, 1.8vw, 26px) clamp(20px, 3.3vw, 48px);
    font-size: var(--fs-0);
  }
  .hero__menu {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    margin-left: -12px;
    text-transform: uppercase;
  }
  .hero__menu svg { width: 24px; height: 24px; }
  .hero__logo img { width: auto; height: clamp(56px, 6.1vw, 88px); transition: opacity 0.3s; }
  .hero__logo:hover img { opacity: 0.75; }
  .hero__map {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-transform: uppercase;
  }
  .hero__menu:hover,
  .hero__map:hover { color: var(--accent); }
  .ph { outline: 1px dashed currentColor; outline-offset: 4px; opacity: 0.85; }

  /* ── Headline ── */
  .hero__title {
    display: grid;
    justify-items: center;
    margin: 0;
    font-weight: var(--fw-display);
    text-align: center;
  }
  .hero__script {
    /* "The Designer" in Filmotype Yukon, exported from Figma (301px wide at 1440) */
    width: clamp(190px, 20.9vw, 301px);
    height: auto;
  }
  .hero__caps {
    font-family: var(--font-display);
    font-size: var(--fs-4);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  /* the role line hangs under the headline without moving it off-centre */
  .hero__center { position: relative; }
  .hero__roles {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0;
    margin: 9px 0 0;
    white-space: nowrap;
    text-align: center;
    font-size: var(--fs-0);
    letter-spacing: -0.006em;
    text-transform: uppercase;
    color: var(--mist);
  }

  /* ── Floating pill menu ── */
  .pill {
    position: absolute;
    left: 50%;
    bottom: clamp(24px, 8.8vh, 79px);
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.2vw, 32px);
    padding: 8px 8px 8px clamp(18px, 1.95vw, 28px);
    background: var(--night-2);
    border: 1px solid rgba(232, 236, 238, 0.85);
    border-radius: 999px;
    white-space: nowrap;
  }
  .pill a {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    border-radius: 999px;
    transition: color 0.25s, background 0.25s;
  }
  .pill__link { padding: 0; }
  .pill__link:hover { color: var(--accent); }
  .pill__cta {
    padding: 0 18px;
    background: var(--fog);
    color: var(--night);
  }
  .pill__cta:hover { background: var(--accent); }

  /* ── Menu dialog ── */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: clamp(20px, 3.3vw, 48px);
    border: 0;
    background: var(--night);
    color: var(--fog);
  }
  .menu::backdrop { background: var(--night); }
  .menu__close {
    min-height: 44px;
    text-transform: uppercase;
    font-size: var(--fs-0);
  }
  .menu ol { margin-top: 10vh; display: grid; gap: 8px; }
  .menu a {
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-6);
    line-height: 1.05;
    letter-spacing: var(--tracking-display);
    transition: color 0.25s;
  }
  .menu a:hover,
  .menu a:focus-visible { color: var(--accent); }

  @media (max-width: 480px) {
    .pill { bottom: 24px; }
    .pill a { letter-spacing: 0.08em; font-size: 11px; }
    .pill__cta { padding: 0 14px; }
  }
</style>
