---
/**
 * Hero — built from Figma "Hero — Option A" (Landing Page, node 256:119).
 * Header (signature only), headline over the portrait, floating pill navigation.
 */
import { site } from '../content/site';

const links = [
  { label: 'Work', href: '#work' },
  { label: 'About', href: '#about' },
];
const email = site.email.replace(/[[\]]/g, '');
---

<section id="top" class="hero" aria-labelledby="hero-title" data-hero>
  <!-- Portrait: a dark "ghost" (Overlay blend, as in Figma) and the full-colour
       original on top, revealed only inside a spotlight where the cursor touches the body. -->
  <img
    class="portrait portrait--ghost"
    src="/images/portrait@1x.webp"
    srcset="/images/portrait@1x.webp 1x, /images/portrait@2x.webp 2x"
    alt=""
    aria-hidden="true"
    width="1080"
    height="865"
    fetchpriority="high"
  />
  <img
    class="portrait portrait--colour"
    src="/images/portrait-colour@1x.webp"
    srcset="/images/portrait-colour@1x.webp 1x, /images/portrait-colour@2x.webp 2x"
    alt=""
    aria-hidden="true"
    width="1080"
    height="865"
    data-colour
  />

  <header class="hero__header">
    <a class="hero__logo" href="#top">
      <img src="/brand/signature.png" alt={`${site.displayName} — home`} width="115" height="88" />
    </a>
    <!-- phones only: the corner journey card would cover the headline, so the journey sits in the top bar -->
    <button class="hero__journey" type="button" data-journey-open aria-haspopup="dialog" aria-controls="journey-map">
      <span class="hero__journey-dot" aria-hidden="true"></span>My journey
    </button>
  </header>

  <div class="hero__center">
  <h1 id="hero-title" class="hero__title">
    <span class="visually-hidden">{site.displayName} — </span>
    <span class="hero__caps">I make complex products <em>feel obvious.</em></span>
  </h1>
  <p class="hero__roles">{site.roles}</p>
  </div>

  <nav class="pill" aria-label="Main">
    {links.map((l) => <a class="pill__link" href={l.href}>{l.label}</a>)}
    <a class="pill__cta" href={`mailto:${email}`} data-contact-open>
      <span class="cta__face" aria-hidden="true"><img src="/images/avatar.webp" alt="" width="48" height="48" /></span>
      <span>Let’s talk</span>
      <span class="cta__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z" /></svg></span>
    </a>
  </nav>
</section>

<script>

  // ── Portrait: glides toward the mouse, and a spotlight reveals the colour
  // original wherever the cursor is over the body (transparent pixels don't count).
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const colour = document.querySelector<HTMLImageElement>('[data-colour]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && colour) {
    const MAX_X = 28, MAX_Y = 18, MAX_R = 1.6; // drift px, px, lean deg
    const RADIUS = () => Math.max(110, Math.min(200, colour.getBoundingClientRect().width * 0.22));
    const ease = still.matches ? 1 : 0.14;
    let tx = 0, ty = 0, cx = 0, cy = 0, ts = 1, cs = 1; // drift
    let tr = 0, cr = 0, mx = 0, my = 0, cmx = 0, cmy = 0; // spotlight
    let raf = 0;

    // alpha hit-test: is the cursor over the body, not the transparent background?
    const probe = document.createElement('canvas');
    const pctx = probe.getContext('2d', { willReadFrequently: true });
    // copy the image into the probe lazily (the 2x source may swap in after first paint)
    let drawn = '';
    const ensureProbe = () => {
      if (!pctx || !colour.complete || !colour.naturalWidth) return false;
      if (drawn !== colour.currentSrc) {
        probe.width = colour.naturalWidth;
        probe.height = colour.naturalHeight;
        pctx.clearRect(0, 0, probe.width, probe.height);
        pctx.drawImage(colour, 0, 0);
        drawn = colour.currentSrc;
      }
      return true;
    };
    colour.addEventListener('load', () => { drawn = ''; });
    const overBody = (x: number, y: number, b: DOMRect) => {
      if (!ensureProbe() || !pctx) return true;
      const u = Math.floor(((x - b.left) / b.width) * probe.width);
      const v = Math.floor(((y - b.top) / b.height) * probe.height);
      if (u < 0 || v < 0 || u >= probe.width || v >= probe.height) return false;
      return pctx.getImageData(u, v, 1, 1).data[3] > 40;
    };

    const tick = () => {
      cx += (tx - cx) * ease; cy += (ty - cy) * ease; cs += (ts - cs) * ease;
      cr += (tr - cr) * (still.matches ? 1 : 0.18);
      cmx += (mx - cmx) * (still.matches ? 1 : 0.35); cmy += (my - cmy) * (still.matches ? 1 : 0.35);
      if (fine.matches && !still.matches) {
        hero.style.setProperty('--px', `${(cx * MAX_X).toFixed(2)}px`);
        hero.style.setProperty('--py', `${(cy * MAX_Y).toFixed(2)}px`);
        hero.style.setProperty('--pr', `${(cx * MAX_R).toFixed(3)}deg`);
        hero.style.setProperty('--ps', cs.toFixed(4));
      }
      colour.style.setProperty('--r', `${cr.toFixed(1)}px`);
      colour.style.setProperty('--mx', `${cmx.toFixed(1)}px`);
      colour.style.setProperty('--my', `${cmy.toFixed(1)}px`);
      const moving = Math.abs(tx - cx) + Math.abs(ty - cy) + Math.abs(ts - cs) + Math.abs(tr - cr) / 50 + (Math.abs(mx - cmx) + Math.abs(my - cmy)) / 50;
      raf = moving > 0.002 ? requestAnimationFrame(tick) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };

    const aim = (e: PointerEvent) => {
      const h = hero.getBoundingClientRect();
      tx = ((e.clientX - h.left) / h.width) * 2 - 1;
      ty = ((e.clientY - h.top) / h.height) * 2 - 1;
      const b = colour.getBoundingClientRect();
      mx = ((e.clientX - b.left) / b.width) * colour.offsetWidth;
      my = ((e.clientY - b.top) / b.height) * colour.offsetHeight;
      if (!cr) { cmx = mx; cmy = my; } // start the spotlight where the cursor enters
      tr = overBody(e.clientX, e.clientY, b) ? RADIUS() : 0;
    };

    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' && e.pointerType !== 'pen') return;
      aim(e); ts = 1.02; kick();
    });
    hero.addEventListener('pointerleave', () => { tx = 0; ty = 0; ts = 1; tr = 0; kick(); });

    // Touch: tap the portrait to reveal the colour there for a moment
    let hide = 0;
    hero.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch') return;
      aim(e); kick();
      clearTimeout(hide);
      hide = window.setTimeout(() => { tr = 0; kick(); }, 1600);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    height: 100svh;
    min-height: 560px;
    padding: 0 var(--gutter);
    background: var(--night);
    color: var(--fog);
  }

  /* ── Portrait ──
     Both layers sit directly in the hero (which isolates blending), so the ghost's
     Overlay blend reaches the night background. Motion vars (--px etc.) live on .hero. */
  .hero { isolation: isolate; overflow: hidden; }
  .portrait {
    position: absolute;
    /* fills the hero: as tall as the screen allows, head near the top, shoulders running off the bottom */
    top: 6%;
    left: 50%;
    height: max(96%, calc(100vw / 1.249 * 0.78));
    width: auto;
    aspect-ratio: 1080 / 865;
    max-width: none;
    translate: -50% 0;
    z-index: -1;
    pointer-events: none;
    user-select: none;
    will-change: transform;
    transform: translate3d(var(--px, 0px), var(--py, 0px), 0) rotate(var(--pr, 0deg)) scale(var(--ps, 1));
  }
  .portrait--ghost {
    mix-blend-mode: overlay;
    /* soften the side and bottom edges into the night */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 14%, #000 86%, transparent), linear-gradient(#000 58%, transparent 92%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 14%, #000 86%, transparent), linear-gradient(#000 58%, transparent 92%);
    mask-composite: intersect;
  }
  /* a gentle shade behind the headline so it reads over the photo */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent 40%, rgba(17, 16, 13, 0.55) 62%, rgba(17, 16, 13, 0.92) 85%);
  }
  .portrait--colour {
    /* spotlight: --r is the radius, --mx/--my the centre (px within the image) */
    -webkit-mask-image: radial-gradient(circle at var(--mx, 50%) var(--my, 30%), #000 0, #000 calc(var(--r, 0px) * 0.55), transparent var(--r, 0px));
    mask-image: radial-gradient(circle at var(--mx, 50%) var(--my, 30%), #000 0, #000 calc(var(--r, 0px) * 0.55), transparent var(--r, 0px));
  }

  /* ── Header ── */
  .hero__header {
    position: absolute;
    inset: 0 0 auto 0;
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    align-items: center;
    padding: clamp(14px, 1.8vw, 26px) clamp(20px, 3.3vw, 48px);
    font-size: var(--fs-0);
  }
  .hero__logo img { width: auto; height: clamp(56px, 6.1vw, 88px); transition: opacity 0.3s; }
  .hero__logo:hover img { opacity: 0.75; }
  .hero__journey { display: none; align-items: center; gap: 8px; padding: 10px 16px; border: 1px solid rgba(208, 197, 171, 0.3); border-radius: 999px; font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fog); transition: background 0.3s, color 0.3s; }
  .hero__journey:hover { background: var(--fog); color: var(--night); }
  .hero__journey-dot { width: 7px; height: 7px; border-radius: 50%; background: #f2c22e; box-shadow: 0 0 0 0 rgba(242, 194, 46, 0.6); animation: journey-dot 2.4s ease-out infinite; }
  @keyframes journey-dot { 70% { box-shadow: 0 0 0 7px rgba(242, 194, 46, 0); } 100% { box-shadow: 0 0 0 0 rgba(242, 194, 46, 0); } }
  @media (max-width: 640px) {
    .hero__header { display: flex; justify-content: space-between; }
    .hero__logo img { height: 52px; }
    .hero__journey { display: inline-flex; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__journey-dot { animation: none; } }
  .ph { outline: 1px dashed currentColor; outline-offset: 4px; opacity: 0.85; }

  /* ── Headline ── */
  .hero__title {
    display: grid;
    justify-items: center;
    margin: 0;
    font-weight: var(--fw-display);
    text-align: center;
  }
  .hero__caps {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2rem, 1rem + 3vw, 4.2rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    max-width: 19ch;
    text-wrap: balance;
  }
  .hero__caps em { font-style: normal; color: var(--accent); }

  /* the role line hangs under the headline without moving it off-centre */
  .hero__center { position: relative; align-self: end; margin-bottom: clamp(140px, 22vh, 220px); }
  .hero__roles {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0;
    margin: 9px 0 0;
    white-space: nowrap;
    text-align: center;
    font-size: var(--fs-0);
    letter-spacing: -0.006em;
    text-transform: uppercase;
    color: var(--mist);
  }

  /* ── Floating pill menu ── */
  .pill {
    position: absolute;
    left: 50%;
    bottom: clamp(24px, 8.8vh, 79px);
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.2vw, 32px);
    padding: 8px 8px 8px clamp(18px, 1.95vw, 28px);
    background: var(--night-2);
    border: 1px solid rgba(208, 197, 171, 0.85);
    border-radius: 999px;
    white-space: nowrap;
  }
  .pill a {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    border-radius: 999px;
    transition: color 0.25s, background 0.25s;
  }
  .pill__link { padding: 0; }
  .pill__link:hover { color: var(--accent); }
  /* Let's talk: your face says "a person answers"; on hover it slides out and a chat icon slides in */
  .pill__cta {
    gap: 10px;
    padding: 0 18px 0 6px;
    background: var(--fog);
    color: var(--night);
    transition: background 0.35s, padding 0.45s var(--ease-out);
  }
  .cta__face, .cta__icon { display: inline-grid; place-items: center; overflow: hidden; transition: width 0.45s var(--ease-out), opacity 0.3s, margin 0.45s var(--ease-out); }
  .cta__face { width: 28px; height: 28px; border-radius: 50%; }
  .cta__face img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
  .cta__icon { width: 0; opacity: 0; margin-left: -10px; }
  .cta__icon svg { width: 18px; height: 18px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; }
  .pill__cta:hover, .pill__cta:focus-visible { background: var(--accent); padding: 0 12px 0 18px; }
  .pill__cta:hover .cta__face, .pill__cta:focus-visible .cta__face { width: 0; opacity: 0; margin-right: -10px; }
  .pill__cta:hover .cta__icon, .pill__cta:focus-visible .cta__icon { width: 20px; opacity: 1; margin-left: 0; }


  @media (max-width: 480px) {
    .pill { bottom: 24px; }
    .pill a { letter-spacing: 0.08em; font-size: 11px; }
    .pill__cta { padding: 0 14px 0 6px; }
  }
</style>
