---
import { contact, closing, site } from '../content/site';
import { rich, plain, isPlaceholder } from '../lib/format';
import Chapter from './Chapter.astro';
import Arrow from './Arrow.astro';

const email = plain(contact.email);
const emailIsPlaceholder = isPlaceholder(contact.email);
// In production, socials without a URL are hidden. While editing they show as placeholders.
const socials = contact.socials.filter((s) => s.href || import.meta.env.DEV);
const year = new Date().getFullYear();
---

<section id="contact" class="section contact" data-theme="mist" data-chapter="6" data-chapter-label="Contact" aria-labelledby="contact-title">
  <div class="wrap">
    <Chapter n={6} label="Contact" />
    <h2 id="contact-title" class="contact__title display" data-reveal set:html={rich(closing.title)} />

    <div class="grid contact__grid">
      <p class="contact__body" data-reveal set:html={rich(closing.body)} />

      <div class="contact__actions" data-reveal style="--d:1">
        <a class="contact__email" href={`mailto:${email}`}>
          <span class:list={[{ ph: emailIsPlaceholder }]}>{email}</span>
          <span class="contact__email-arrow" aria-hidden="true"><Arrow dir="up-right" /></span>
        </a>
        <button class="label contact__copy" type="button" data-copy={email}>
          <span data-copy-label>Copy email</span>
        </button>
        <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
      </div>
    </div>

    <div class="contact__links">
      <ul class="contact__socials" aria-label="Social profiles">
        {
          socials.map((s) => (
            <li>
              {s.href ? (
                <a class="label social" href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label} <Arrow dir="up-right" />
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              ) : (
                <span class="label social"><span class="ph">{s.label} — add URL</span></span>
              )}
            </li>
          ))
        }
        {
          contact.cv && (
            <li>
              <a class="label social" href={contact.cv}>Download CV <Arrow dir="down" /></a>
            </li>
          )
        }
      </ul>
    </div>

    <footer class="contact__footer label">
      <span>© {year} {site.name}</span>
      <span class="contact__roles">{site.roles.join(' · ')}</span>
      <a class="contact__top" href="#top">Back to top <Arrow dir="up" /></a>
    </footer>
  </div>
</section>

<style>
  .contact { padding-bottom: clamp(24px, 3vw, 40px); }
  .contact__title {
    font-size: var(--type-display);
    max-width: 11ch;
    text-wrap: balance;
  }
  .contact__grid {
    margin-top: clamp(48px, 7vw, 100px);
    row-gap: 40px;
    align-items: end;
  }
  .contact__body {
    grid-column: 1 / -1;
    font-size: var(--type-lede);
    line-height: 1.5;
    max-width: 34ch;
  }
  .contact__actions {
    grid-column: 1 / -1;
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-display);
    font-size: var(--fs-4);
    line-height: 1.1;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 4px;
    transition: background-size 0.5s var(--ease-out);
  }
  .contact__email:hover { background-size: 0 1px; background-position: 100% 100%; }
  .contact__email-arrow :global(svg) {
    width: 0.6em;
    height: 0.6em;
    transition: transform 0.4s var(--ease-out);
  }
  .contact__email:hover .contact__email-arrow :global(svg) { transform: translate(4px, -4px); }
  .contact__copy {
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid currentColor;
    border-radius: 999px;
    transition: background 0.3s, color 0.3s;
  }
  .contact__copy:hover { background: var(--fg); color: var(--bg); }

  .contact__links {
    margin-top: clamp(56px, 8vw, 120px);
    border-top: 1px solid var(--line);
  }
  .contact__socials {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  .contact__socials li { border-bottom: 1px solid var(--line); }
  .social {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
    padding-right: 16px;
    transition: padding 0.4s var(--ease-out);
  }
  .social :global(svg) { width: 14px; height: 14px; }
  a.social:hover { padding-left: 12px; }
  @media (min-width: 760px) {
    .contact__socials { grid-template-columns: repeat(4, 1fr); }
    .contact__socials li + li { border-left: 1px solid var(--line); padding-left: 16px; }
    .contact__socials li:nth-child(4n + 1) { border-left: 0; padding-left: 0; }
  }

  .contact__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 32px;
    margin-top: clamp(64px, 10vw, 160px);
  }
  .contact__top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
  .contact__top :global(svg) { width: 12px; height: 12px; }

  @media (min-width: 960px) {
    .contact__body { grid-column: 1 / span 5; }
    .contact__actions { grid-column: 7 / -1; justify-items: end; text-align: right; }
  }
</style>
