---
/**
 * The journey map — a secondary layer of the portfolio (after Sobha's "Open the map").
 * A small card sits in the bottom-right corner; it (and the hero's "3D Map") opens
 * a full-screen map over the page. Inside, the danfo → plane → car glide from stop
 * to stop with Next / Prev, arrow keys, a scroll gesture, a swipe, or Play.
 * Copy: src/content/site.ts (`journey`). Engine: src/scripts/journey.ts.
 */
import 'maplibre-gl/dist/maplibre-gl.css';
import { journey } from '../content/site';

const pad = (n: number) => String(n).padStart(2, '0');
const rich = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\[(.+?)\]/g, '<span class="ph">$1</span>');
---

<!-- Corner card -->
<button class="mapcard" type="button" data-journey-open aria-haspopup="dialog" aria-controls="journey-map">
  <svg class="mapcard__art" viewBox="0 0 160 96" aria-hidden="true">
    <defs>
      <radialGradient id="mc-glow" cx="50%" cy="40%" r="70%">
        <stop offset="0" stop-color="#1d252d" />
        <stop offset="1" stop-color="#0c1014" />
      </radialGradient>
    </defs>
    <rect width="160" height="96" fill="url(#mc-glow)" />
    <circle cx="80" cy="112" r="92" fill="none" stroke="rgba(232,236,238,0.16)" />
    <circle cx="80" cy="112" r="70" fill="none" stroke="rgba(232,236,238,0.08)" />
    <path d="M58 70 C 60 46, 72 30, 92 22" fill="none" stroke="rgba(232,236,238,0.35)" stroke-dasharray="2 3" />
    <path class="mapcard__lit" d="M58 70 C 60 46, 72 30, 92 22" fill="none" stroke="#f2c22e" stroke-width="1.6" stroke-linecap="round" pathLength="1" />
    <circle cx="58" cy="70" r="2.6" fill="#f2c22e" />
    <circle cx="92" cy="22" r="2.6" fill="none" stroke="#e8ecee" />
  </svg>
  <span class="mapcard__3d">3D</span>
  <span class="mapcard__cta">Open the map</span>
  <span class="visually-hidden">— my journey from Nigeria to Dublin</span>
</button>

<!-- Full-screen map -->
<dialog id="journey-map" class="jmap" aria-labelledby="journey-title" data-journey style={`--stops:${journey.stops.length}`}>
  <div class="jmap__stage" data-lenis-prevent>
    <div class="jmap__map" data-jmap aria-hidden="true"></div>
    <div class="jmap__fog" aria-hidden="true"></div>

    <header class="jmap__top">
      <p class="label jmap__kicker">{journey.kicker}</p>
      <button class="jmap__close label" type="button" data-journey-close>Close <span aria-hidden="true">✕</span></button>
    </header>

    <div class="jmap__intro" data-jintro>
      <h2 id="journey-title" class="jmap__title">{journey.title}</h2>
      <p class="jmap__lede">{journey.intro}</p>
    </div>

    <ol class="jcards" aria-live="polite">
      {
        journey.stops.map((s, i) => (
          <li class="jcard" data-jcard={i}>
            <p class="label jcard__when">
              <span class="jcard__n">{pad(i + 1)}</span>
              <span class="jcard__rule" aria-hidden="true" />
              <span set:html={rich(s.when)} />
            </p>
            <h3 class="jcard__title">{s.title}</h3>
            <p class="jcard__role">{s.role} · <span set:html={rich(s.place)} /></p>
            <ul class="jcard__points">{s.points.map((pt) => <li set:html={rich(pt)} />)}</ul>
            {s.metrics && <ul class="jcard__metrics" aria-label="Results">{s.metrics.map((m) => <li>{m}</li>)}</ul>}
            {s.links && (
              <ul class="jcard__links">
                {s.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} ↗</a></li>)}
              </ul>
            )}
          </li>
        ))
      }
    </ol>

    <nav class="jnav" aria-label="Journey stops">
      <ol>
        {
          journey.stops.map((s, i) => (
            <li>
              <button type="button" data-jgoto={i + 1}>
                <span class="jnav__when" set:html={rich(s.when)} />
                <span class="jnav__title">{s.title}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="jctrl" role="group" aria-label="Journey controls">
      <button type="button" class="jctrl__btn" data-jprev aria-label="Previous stop">←</button>
      <p class="jctrl__count label"><span data-jcount>00</span> / {pad(journey.stops.length)}</p>
      <button type="button" class="jctrl__btn" data-jnext aria-label="Next stop">→</button>
      <button type="button" class="jctrl__play label" data-jplay aria-pressed="false">Play</button>
    </div>
    <p class="jmap__hint label" data-jhint>Press → or scroll to start the journey</p>
  </div>
</dialog>

<script type="application/json" id="journey-data" set:html={JSON.stringify(journey.stops)} />

<style>
  /* ── Corner card ── */
  .mapcard {
    position: fixed;
    right: clamp(14px, 2vw, 28px);
    bottom: clamp(14px, 2vw, 28px);
    z-index: 40;
    width: clamp(132px, 12vw, 176px);
    aspect-ratio: 160 / 96;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(232, 236, 238, 0.22);
    border-radius: 4px;
    color: var(--fog);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    transition: transform 0.6s var(--ease-out), border-color 0.4s;
  }
  .mapcard__art { position: absolute; inset: 0; width: 100%; height: 100%; transition: transform 0.9s var(--ease-out); }
  .mapcard__lit { stroke-dasharray: 1; stroke-dashoffset: 0.55; transition: stroke-dashoffset 0.9s var(--ease-out); }
  .mapcard__3d { position: absolute; left: 10px; top: 8px; font-family: var(--font-display); font-size: 20px; line-height: 1; }
  .mapcard__cta {
    position: absolute;
    right: 10px;
    bottom: 8px;
    max-width: 60%;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    line-height: 1.25;
    text-transform: uppercase;
    text-align: right;
  }
  .mapcard:hover { transform: translateY(-3px); border-color: rgba(232, 236, 238, 0.6); }
  .mapcard:hover .mapcard__art { transform: scale(1.06); }
  .mapcard:hover .mapcard__lit { stroke-dashoffset: 0; }

  /* ── Full-screen map ── */
  .jmap {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--night);
    color: var(--fog);
    overscroll-behavior: contain;
  }
  .jmap::backdrop { background: var(--night); }
  .jmap[open] { animation: jmap-in 0.6s var(--ease-out); }
  @keyframes jmap-in { from { opacity: 0; } }
  .jmap__stage { position: relative; width: 100%; height: 100%; overflow: hidden; isolation: isolate; }
  .jmap__map { position: absolute; inset: 0; background: var(--night); }
  .jmap__map :global(.maplibregl-ctrl-attrib) { background: rgba(12, 16, 20, 0.6); color: rgba(232, 236, 238, 0.6); font: 400 10px/1.4 var(--font-sans); }
  .jmap__map :global(.maplibregl-ctrl-attrib a) { color: inherit; }
  .jmap__map :global(.maplibregl-ctrl-attrib-button) { filter: invert(1); }
  .jmap__fog {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(12, 16, 20, 0.85), rgba(12, 16, 20, 0) 18%),
      linear-gradient(to top, rgba(12, 16, 20, 0.85), rgba(12, 16, 20, 0) 30%),
      radial-gradient(130% 100% at 60% 45%, transparent 55%, rgba(12, 16, 20, 0.7));
  }

  .jmap__top {
    position: absolute;
    inset: 0 0 auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: clamp(14px, 2vw, 26px) var(--gutter);
  }
  .jmap__kicker { color: var(--mist); }
  .jmap__close {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid rgba(232, 236, 238, 0.35);
    border-radius: 999px;
    transition: background 0.3s, color 0.3s;
  }
  .jmap__close:hover { background: var(--fog); color: var(--night); }

  .jmap__intro {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    padding: var(--gutter);
    text-align: center;
    pointer-events: none;
    background: radial-gradient(60% 50% at 50% 50%, rgba(12, 16, 20, 0.65), transparent 75%);
    transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
  }
  .jmap__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--fs-7);
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .jmap__lede { max-width: 42ch; color: rgba(232, 236, 238, 0.75); font-size: var(--type-small); }

  /* Cards */
  .jcards {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(88px, 12vh, 110px);
    width: min(440px, calc(100% - 2 * var(--gutter)));
    pointer-events: none;
  }
  .jcard {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    display: grid;
    gap: 10px;
    padding: clamp(18px, 2.2vw, 28px);
    background: rgba(12, 16, 20, 0.8);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(232, 236, 238, 0.14);
    border-radius: 4px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: opacity 0.6s var(--ease-out), transform 0.7s var(--ease-out), visibility 0s linear 0.7s;
  }
  .jcard.is-active { opacity: 1; visibility: visible; transform: none; pointer-events: auto; transition-delay: 0s; }
  .jcard__when { display: flex; align-items: center; gap: 12px; color: var(--mist); }
  .jcard__n { color: var(--fog); }
  .jcard__rule { width: 28px; height: 1px; background: rgba(232, 236, 238, 0.3); }
  .jcard__title { margin: 0; font-family: var(--font-display); font-weight: 300; font-size: var(--fs-4); line-height: 1; }
  .jcard__role { margin: 0; font-size: var(--type-small); color: rgba(232, 236, 238, 0.8); }
  .jcard__points { display: grid; gap: 6px; font-size: var(--type-small); line-height: 1.5; color: rgba(232, 236, 238, 0.72); }
  .jcard__points li { position: relative; padding-left: 16px; }
  .jcard__points li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 8px; height: 1px; background: var(--mist); }
  .jcard__metrics { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .jcard__metrics li { padding: 6px 12px; border-radius: 999px; background: #e8ecee; color: var(--night); font-size: 12px; font-weight: 500; }
  .jcard__links { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: var(--type-small); }
  .jcard__links a { border-bottom: 1px solid rgba(232, 236, 238, 0.4); }
  .jcard__links a:hover { color: var(--accent); border-color: var(--accent); }

  /* Year index */
  .jnav {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    padding: 10px 14px;
    background: rgba(12, 16, 20, 0.6);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-radius: 4px;
  }
  .jnav ol { display: grid; border-left: 1px solid rgba(232, 236, 238, 0.18); }
  .jnav button {
    display: grid;
    gap: 1px;
    text-align: left;
    padding: 5px 0 5px 14px;
    margin-left: -1px;
    border-left: 1px solid transparent;
    color: rgba(232, 236, 238, 0.5);
    transition: color 0.4s, border-color 0.4s;
  }
  .jnav button:hover,
  .jnav button[aria-current='true'] { color: var(--fog); border-left-color: var(--fog); }
  .jnav__when { font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; }
  .jnav__title { font-family: var(--font-display); font-size: 16px; line-height: 1.1; }

  /* Controls */
  .jctrl {
    position: absolute;
    left: 50%;
    bottom: clamp(20px, 3.5vh, 36px);
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 6px;
    background: rgba(21, 27, 33, 0.85);
    border: 1px solid rgba(232, 236, 238, 0.3);
    border-radius: 999px;
  }
  .jctrl__btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: background 0.3s, color 0.3s;
  }
  .jctrl__btn:hover { background: var(--fog); color: var(--night); }
  .jctrl__btn:disabled { opacity: 0.3; pointer-events: none; }
  .jctrl__count { min-width: 64px; text-align: center; }
  .jctrl__play {
    min-height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--fog);
    color: var(--night);
  }
  .jctrl__play[aria-pressed='true'] { background: transparent; color: var(--fog); box-shadow: inset 0 0 0 1px rgba(232, 236, 238, 0.4); }
  .jmap__hint {
    position: absolute;
    left: 50%;
    bottom: clamp(80px, 11vh, 100px);
    translate: -50% 0;
    color: rgba(232, 236, 238, 0.7);
    transition: opacity 0.5s;
    white-space: nowrap;
  }

  /* Stop pins (MapLibre markers, injected) */
  :global(.jstop) { pointer-events: none; }
  :global(.jstop__dot) { display: block; width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid #e8ecee; background: rgba(12, 16, 20, 0.7); position: relative; }
  :global(.jstop__dot::before), :global(.jstop__dot::after) { content: ''; position: absolute; left: 50%; top: 50%; background: #e8ecee; transform: translate(-50%, -50%); }
  :global(.jstop__dot::before) { width: 6px; height: 1.5px; }
  :global(.jstop__dot::after) { width: 1.5px; height: 6px; }
  :global(.jstop__label) {
    position: absolute; left: 50%; bottom: 22px; translate: -50% 0;
    white-space: nowrap; font: 500 11px/1 var(--font-sans); letter-spacing: 0.16em; text-transform: uppercase;
    color: #e8ecee; text-shadow: 0 1px 8px rgba(0, 0, 0, 0.95); opacity: 0; transition: opacity 0.5s;
  }
  :global(.jstop.is-active .jstop__label) { opacity: 1; }
  :global(.jstop.is-active .jstop__dot) { background: #e8ecee; }
  :global(.jstop.is-active .jstop__dot::before), :global(.jstop.is-active .jstop__dot::after) { background: var(--night); }

  .ph { outline: 1px dashed currentColor; outline-offset: 2px; }

  /* No WebGL: the map shows the stops as a list */
  .jmap:global(.is-static) .jmap__stage { overflow: auto; padding: 96px var(--gutter) 48px; }
  .jmap:global(.is-static) :is(.jmap__map, .jmap__fog, .jnav, .jctrl, .jmap__hint) { display: none; }
  .jmap:global(.is-static) .jmap__intro { position: relative; background: none; }
  .jmap:global(.is-static) .jcards { position: relative; left: 0; bottom: 0; width: auto; display: grid; gap: 16px; max-width: 640px; margin: 32px auto 0; }
  .jmap:global(.is-static) .jcard { position: relative; opacity: 1; visibility: visible; transform: none; }

  @media (max-width: 900px) {
    .jnav { display: none; }
    .jcards { bottom: 92px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .jmap[open] { animation: none; }
  }
</style>

<script>
  import { initJourney } from '../scripts/journey';
  initJourney();
</script>
