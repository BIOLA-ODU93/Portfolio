---
/**
 * The journey map — a secondary layer of the portfolio (after Sobha's "Open the map").
 * A small card sits in the bottom-right corner; it (and the hero's "3D Map") opens
 * a full-screen map over the page. Inside, the danfo → plane → car glide from stop
 * to stop with Next / Prev, arrow keys, a scroll gesture, a swipe, or Play.
 * Copy: src/content/site.ts (`journey`). Engine: src/scripts/journey.ts.
 */
import 'maplibre-gl/dist/maplibre-gl.css';
import { journey } from '../content/site';

const pad = (n: number) => String(n).padStart(2, '0');
const rich = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\[(.+?)\]/g, '<span class="ph">$1</span>');
---

<!-- Corner card (a postcard of the journey) -->
<button class="mapcard" type="button" data-journey-open aria-haspopup="dialog" aria-controls="journey-map">
  <span class="mapcard__media">
    <img src="/images/journey-card.jpg" alt="" width="600" height="400" loading="lazy" decoding="async" />
    <span class="mapcard__badge">3D</span>
    <span class="mapcard__pulse" aria-hidden="true"></span>
    <span class="mapcard__credit" aria-hidden="true">© OpenStreetMap</span>
  </span>
  <span class="mapcard__caption">
    <span class="mapcard__text">
      <span class="mapcard__title">My journey</span>
      <span class="mapcard__meta">Lagos → Dublin</span>
    </span>
    <span class="mapcard__go" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="14" height="14"><path d="M3 13L13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
    </span>
  </span>
  <span class="mapcard__mini" aria-hidden="true">3D<span class="mapcard__mini-dot"></span></span>
  <span class="visually-hidden">Open the 3D map of my journey from Lagos to Dublin</span>
</button>

<!-- Full-screen map -->
<dialog id="journey-map" class="jmap" aria-labelledby="journey-title" data-journey style={`--stops:${journey.stops.length}`}>
  <div class="jmap__stage" data-lenis-prevent>
    <div class="jmap__map" data-jmap aria-hidden="true"></div>
    <div class="jmap__fog" aria-hidden="true"></div>

    <header class="jmap__top">
      <p class="label jmap__kicker">{journey.kicker}</p>
      <div class="jmap__actions">
        <button class="jmap__sound label" type="button" data-jsound aria-pressed="true">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z" /><path class="jmap__waves" d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" /></svg>
          <span data-jsound-label>Sound on</span>
        </button>
        <button class="jmap__close label" type="button" data-journey-close>Close <span aria-hidden="true">✕</span></button>
      </div>
    </header>

    <div class="jmap__intro" data-jintro>
      <h2 id="journey-title" class="jmap__title">{journey.title}</h2>
      <p class="jmap__lede">{journey.intro}</p>
    </div>

    <!-- Stop panels: open from the + on each stop (Sobha-style), one at a time -->
    <div class="jpanels">
      {
        journey.stops.map((s, i) => (
          <article class="jcard" data-jcard={i} id={`stop-${s.slug}`} aria-labelledby={`stop-${s.slug}-title`} aria-hidden="true">
            <header class="jcard__top">
              <p class="label jcard__n">{pad(i + 1)} / {pad(journey.stops.length)}</p>
              <button type="button" class="label jcard__close" data-jpanel-close>Close <span aria-hidden="true">✕</span></button>
            </header>
            <div class="jcard__body">
              {s.photo
                ? <img class="jcard__photo" src={s.photo} alt="" loading="lazy" decoding="async" />
                : <div class="jcard__photo jcard__photo--empty" aria-hidden="true"><span>{s.title}</span></div>}
              <p class="label jcard__when"><span set:html={rich(s.when)} /> · <span set:html={rich(s.place)} /></p>
              <h3 class="jcard__title" id={`stop-${s.slug}-title`}>{s.title}</h3>
              <p class="jcard__role">{s.role}</p>
              <div class="jcard__story">{s.points.map((pt) => <p set:html={rich(pt)} />)}</div>
              {s.metrics && <ul class="jcard__metrics" aria-label="Results">{s.metrics.map((m) => <li>{m}</li>)}</ul>}
              {s.links && (
                <ul class="jcard__links">
                  {s.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label} ↗</a></li>)}
                </ul>
              )}
            </div>
            <footer class="jcard__foot">
              <span class="jcard__cases">
                {(s.caseStudies ?? []).map((c) => <a href={c.href}>{c.label} case study →</a>)}
              </span>
              {i < journey.stops.length - 1 && <button type="button" class="jcard__next" data-jpanel-next>Next stop <span aria-hidden="true">↓</span></button>}
            </footer>
          </article>
        ))
      }
    </div>

    <nav class="jnav" aria-label="Journey stops">
      <ol>
        {
          journey.stops.map((s, i) => (
            <li>
              <button type="button" data-jgoto={i + 1}>
                <span class="jnav__when" set:html={rich(s.when)} />
                <span class="jnav__title">{s.title}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="jctrl" role="group" aria-label="Journey controls">
      <button type="button" class="jctrl__btn" data-jprev aria-label="Previous stop">←</button>
      <p class="jctrl__count label"><span data-jcount>00</span> / {pad(journey.stops.length)}</p>
      <button type="button" class="jctrl__btn" data-jnext aria-label="Next stop">→</button>
      <button type="button" class="jctrl__play label" data-jplay aria-pressed="false">Play</button>
    </div>
    <p class="jmap__hint label" data-jhint>Press → or scroll to start the journey</p>
  </div>
</dialog>

<script type="application/json" id="journey-data" set:html={JSON.stringify(journey.stops)} />

<style>
  /* ── Corner card ── */
  .mapcard {
    position: fixed;
    right: clamp(14px, 2vw, 28px);
    bottom: clamp(14px, 2vw, 28px);
    z-index: 40;
    width: clamp(200px, 16vw, 236px);
    display: grid;
    padding: 4px;
    text-align: left;
    color: var(--fog);
    background: rgba(21, 27, 33, 0.82);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(208, 197, 171, 0.16);
    border-radius: 8px;
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.6);
    /* arrives quietly a moment after the page */
    opacity: 0;
    transform: translateY(14px);
    animation: card-in 0.9s var(--ease-out) 1.2s forwards;
    transition: transform 0.6s var(--ease-out), border-color 0.4s, box-shadow 0.6s var(--ease-out);
  }
  @keyframes card-in { to { opacity: 1; transform: none; } }
  .mapcard__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 5px;
  }
  .mapcard__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease-out), filter 0.6s; filter: saturate(0.9) brightness(0.9); }
  .mapcard__badge {
    position: absolute;
    left: 8px;
    top: 8px;
    padding: 3px 7px;
    border-radius: 999px;
    background: rgba(17, 16, 13, 0.7);
    border: 1px solid rgba(208, 197, 171, 0.25);
    font: 500 10px/1 var(--font-sans);
    letter-spacing: 0.14em;
  }
  /* Lagos, where it starts */
  .mapcard__pulse {
    position: absolute;
    left: 55.4%;
    top: 91%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: #f2c22e;
    box-shadow: 0 0 0 0 rgba(242, 194, 46, 0.6);
    animation: card-pulse 2.4s ease-out infinite;
  }
  @keyframes card-pulse { 70% { box-shadow: 0 0 0 10px rgba(242, 194, 46, 0); } 100% { box-shadow: 0 0 0 0 rgba(242, 194, 46, 0); } }
  .mapcard__credit {
    position: absolute;
    right: 6px;
    bottom: 4px;
    font: 400 7px/1 var(--font-sans);
    color: rgba(208, 197, 171, 0.45);
  }
  .mapcard__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 8px 8px 8px;
  }
  .mapcard__text { display: grid; gap: 3px; min-width: 0; } /* lets the caption shrink instead of pushing the arrow out */
  .mapcard__title { font-family: var(--font-display); font-weight: 500; font-size: 17px; line-height: 1.05; letter-spacing: -0.02em; }
  .mapcard__meta { font-size: 9px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: rgba(208, 197, 171, 0.6); }
  .mapcard__go {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid rgba(208, 197, 171, 0.3);
    transition: background 0.4s, color 0.4s, transform 0.5s var(--ease-out);
  }
  .mapcard:hover { transform: translateY(-4px); border-color: rgba(208, 197, 171, 0.4); box-shadow: 0 32px 56px -12px rgba(0, 0, 0, 0.7); }
  .mapcard:hover .mapcard__media img { transform: scale(1.07); filter: none; }
  .mapcard:hover .mapcard__go { background: var(--fog); color: var(--night); transform: rotate(45deg); }
  .mapcard:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  /* Past the hero the card tucks into a small round "3D" button, so it never covers content */
  .mapcard__mini { display: none; }
  .mapcard:global(.is-compact) {
    width: 56px;
    padding: 0;
    aspect-ratio: 1;
    border-radius: 50%;
    place-items: center;
  }
  .mapcard:global(.is-compact) :is(.mapcard__media, .mapcard__caption) { display: none; }
  .mapcard:global(.is-compact) .mapcard__mini {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-display);
    font-size: 19px;
  }
  .mapcard__mini-dot {
    position: absolute;
    right: 12px;
    top: 12px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #f2c22e;
    animation: card-pulse 2.4s ease-out infinite;
  }
  .mapcard:global(.is-compact):hover { transform: translateY(-3px) scale(1.04); }

  /* ── Full-screen map ── */
  .jmap {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--night);
    color: var(--fog);
    overscroll-behavior: contain;
  }
  /* Smooth fade in/out (classes set by journey.ts) */
  .jmap { opacity: 0; transition: opacity 0.7s var(--ease-out); }
  .jmap::backdrop { background: var(--night); opacity: 0; transition: opacity 0.7s var(--ease-out); }
  .jmap:global(.is-in) { opacity: 1; }
  .jmap:global(.is-in)::backdrop { opacity: 1; }
  /* the map fades in once its tiles are drawn, so it never pops in half-finished */
  .jmap__map { opacity: 0; transition: opacity 1.2s var(--ease-out); }
  .jmap__map:global(.is-ready) { opacity: 1; }
  /* title and controls rise in a beat after the overlay */
  .jmap__top, .jmap__intro > *, .jctrl, .jnav {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.8s var(--ease-out), transform 0.9s var(--ease-out);
  }
  .jctrl { transform: translate(0, 12px); }
  .jnav { transform: translate(0, calc(-50% + 12px)); }
  .jmap:global(.is-in) :is(.jmap__top, .jmap__intro > *, .jctrl, .jnav) { opacity: 1; transform: none; }
  .jmap:global(.is-in) .jnav { transform: translateY(-50%); }
  .jmap:global(.is-in) .jmap__intro > :nth-child(1) { transition-delay: 0.25s; }
  .jmap:global(.is-in) .jmap__intro > :nth-child(2) { transition-delay: 0.4s; }
  .jmap:global(.is-in) .jctrl { transition-delay: 0.5s; }
  .jmap:global(.is-in) .jnav { transition-delay: 0.6s; }
  .jmap:global(.is-in) .jmap__top { transition-delay: 0.2s; }
  .jmap__stage { position: relative; width: 100%; height: 100%; overflow: hidden; isolation: isolate; }
  .jmap__map { position: absolute; inset: 0; background: var(--night); }
  .jmap__map :global(.maplibregl-ctrl-attrib) { background: rgba(17, 16, 13, 0.6); color: rgba(208, 197, 171, 0.6); font: 400 10px/1.4 var(--font-sans); }
  .jmap__map :global(.maplibregl-ctrl-attrib a) { color: inherit; }
  .jmap__map :global(.maplibregl-ctrl-attrib-button) { filter: invert(1); }
  .jmap__fog {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      /* deeper haze at the top: the tilted camera looks towards the horizon */
      linear-gradient(to bottom, rgba(17, 16, 13, 0.95), rgba(17, 16, 13, 0.55) 16%, rgba(17, 16, 13, 0) 42%),
      linear-gradient(to top, rgba(17, 16, 13, 0.85), rgba(17, 16, 13, 0) 30%),
      radial-gradient(130% 100% at 60% 45%, transparent 55%, rgba(17, 16, 13, 0.7));
  }

  .jmap__top {
    position: absolute;
    inset: 0 0 auto 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: clamp(14px, 2vw, 26px) var(--gutter);
  }
  .jmap__kicker { color: var(--mist); }
  .jmap__close {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid rgba(208, 197, 171, 0.35);
    border-radius: 999px;
    transition: background 0.3s, color 0.3s;
  }
  .jmap__close:hover { background: var(--fog); color: var(--night); }
  .jmap__actions { display: flex; gap: 10px; align-items: center; }
  .jmap__sound {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    color: var(--mist);
    transition: color 0.3s, background 0.3s;
  }
  .jmap__sound:hover { color: var(--fog); background: rgba(208, 197, 171, 0.08); }
  .jmap__sound svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round; }
  .jmap__sound[aria-pressed='false'] .jmap__waves { opacity: 0.2; }
  @media (max-width: 640px) { .jmap__sound span { display: none; } }

  .jmap__intro {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    padding: var(--gutter);
    text-align: center;
    pointer-events: none;
    background: radial-gradient(60% 50% at 50% 50%, rgba(17, 16, 13, 0.65), transparent 75%);
    transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
  }
  .jmap__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-display);
    font-size: var(--fs-6);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  /* keep the title clear of the year index on the right (mirrored so it stays centred) */
  @media (min-width: 901px) { .jmap__intro { padding-inline: calc(var(--gutter) + 200px); } }
  .jmap__lede { max-width: 42ch; color: rgba(208, 197, 171, 0.75); font-size: var(--type-small); }

  /* Stop panels — fade in on the right when a + is pressed */
  .jpanels { position: absolute; inset: 0; pointer-events: none; z-index: 3; }
  .jcard {
    position: absolute;
    top: 24px;
    right: 24px;
    bottom: 24px;
    width: min(440px, calc(100% - 48px));
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: rgba(24, 23, 19, 0.97);
    border: 1px solid rgba(208, 197, 171, 0.1);
    border-radius: 6px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: opacity 0.4s var(--ease-out), transform 0.5s var(--ease-out), visibility 0s linear 0.5s;
  }
  .jcard.is-open { opacity: 1; visibility: visible; transform: none; pointer-events: auto; transition: opacity 0.6s var(--ease-out), transform 0.7s var(--ease-out), visibility 0s; }
  .jcard__top, .jcard__foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 28px; }
  .jcard__n { color: var(--mist); }
  .jcard__close { min-height: 36px; color: var(--fog); }
  .jcard__close:hover, .jcard__next:hover { color: var(--accent); }
  .jcard__body { display: grid; align-content: start; gap: 12px; padding: 0 28px 8px; overflow-y: auto; overscroll-behavior: contain; }
  .jcard__photo { width: 100%; aspect-ratio: 3 / 2; max-height: 28svh; object-fit: cover; border-radius: 4px; margin-bottom: 12px; }
  .jcard__photo--empty { display: grid; place-items: center; background: radial-gradient(120% 90% at 30% 20%, #26231d, #181713); border: 1px solid rgba(208, 197, 171, 0.08); }
  .jcard__photo--empty span { font-family: var(--font-display); font-size: clamp(1.4rem, 1rem + 1vw, 2rem); letter-spacing: -0.03em; color: rgba(208, 197, 171, 0.22); text-align: center; padding: 0 24px; }
  .jcard__when { color: var(--mist); }
  .jcard__title { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(1.9rem, 1.2rem + 1.6vw, 2.6rem); line-height: 1.04; letter-spacing: -0.035em; }
  .jcard__role { margin: 0; color: var(--accent); font-size: var(--type-small); }
  .jcard__story { display: grid; gap: 10px; margin-top: 4px; font-size: 15px; line-height: 1.6; color: rgba(208, 197, 171, 0.82); }
  .jcard__story p { margin: 0; }
  .jcard__metrics { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 0; padding: 0; list-style: none; }
  .jcard__metrics li { padding: 7px 12px; border-radius: 999px; background: rgba(208, 197, 171, 0.1); font-size: 12px; font-weight: 500; }
  .jcard__links { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 4px 0 0; padding: 0; list-style: none; font-size: var(--type-small); }
  .jcard__links a { border-bottom: 1px solid rgba(208, 197, 171, 0.4); }
  .jcard__foot { border-top: 1px solid rgba(208, 197, 171, 0.12); margin: 0 28px; padding: 18px 0 22px; }
  .jcard__cases { display: grid; gap: 6px; font-size: 14px; font-weight: 600; }
  .jcard__cases a:hover { color: var(--accent); }
  .jcard__next { font-size: 14px; color: var(--mist); white-space: nowrap; }
  @media (max-height: 720px) { .jcard__photo { display: none; } }
  /* while a panel is open: the map dims a touch and the year index steps aside */
  .jmap:global(.has-panel) .jmap__fog { background: rgba(17, 16, 13, 0.28); }
  .jmap:global(.has-panel) .jnav { opacity: 0; pointer-events: none; }
  @media (max-width: 640px) {
    .jcard { top: auto; left: 0; right: 0; bottom: 0; width: 100%; max-height: 78svh; border-radius: 18px 18px 0 0; transform: translateY(40px); }
    .jcard.is-open { transform: none; }
    .jcard__top { padding-top: 26px; }
    .jcard__top::before { content: ''; position: absolute; top: 9px; left: 50%; width: 40px; height: 4px; margin-left: -20px; border-radius: 2px; background: rgba(208, 197, 171, 0.3); }
  }

  /* Year index */
  .jnav {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    transform: translateY(-50%);
    padding: 10px 14px;
    background: rgba(17, 16, 13, 0.6);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-radius: 4px;
  }
  .jnav ol { display: grid; border-left: 1px solid rgba(208, 197, 171, 0.18); }
  .jnav button {
    display: grid;
    gap: 1px;
    text-align: left;
    padding: 5px 0 5px 14px;
    margin-left: -1px;
    border-left: 1px solid transparent;
    color: rgba(208, 197, 171, 0.5);
    transition: color 0.4s, border-color 0.4s;
  }
  .jnav button:hover,
  .jnav button[aria-current='true'] { color: var(--fog); border-left-color: var(--fog); }
  .jnav__when { font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; }
  .jnav__title { font-family: var(--font-display); font-weight: 500; font-size: 15px; line-height: 1.1; letter-spacing: -0.01em; }

  /* Controls */
  .jctrl {
    position: absolute;
    left: 50%;
    bottom: clamp(20px, 3.5vh, 36px);
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 6px;
    background: rgba(21, 27, 33, 0.85);
    border: 1px solid rgba(208, 197, 171, 0.3);
    border-radius: 999px;
  }
  .jctrl__btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: background 0.3s, color 0.3s;
  }
  .jctrl__btn:hover { background: var(--fog); color: var(--night); }
  .jctrl__btn:disabled { opacity: 0.3; pointer-events: none; }
  .jctrl__count { min-width: 64px; text-align: center; }
  .jctrl__play {
    min-height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--fog);
    color: var(--night);
  }
  .jctrl__play[aria-pressed='true'] { background: transparent; color: var(--fog); box-shadow: inset 0 0 0 1px rgba(208, 197, 171, 0.4); }
  .jmap__hint {
    position: absolute;
    left: 50%;
    bottom: clamp(80px, 11vh, 100px);
    translate: -50% 0;
    color: rgba(208, 197, 171, 0.7);
    transition: opacity 0.5s;
    white-space: nowrap;
  }

  /* Stop pins (MapLibre markers, injected) */
  :global(.jstop) { display: flex; align-items: center; gap: 10px; }
  :global(.jstop__dot) {
    display: grid; place-items: center; width: 30px; height: 30px; padding: 0; border-radius: 50%;
    border: 1.2px solid rgba(208, 197, 171, 0.9); background: rgba(17, 16, 13, 0.75); color: #d0c5ab;
    font: 400 20px/1 var(--font-sans); cursor: pointer; position: relative; transition: background 0.3s, color 0.3s, transform 0.3s;
  }
  :global(.jstop__dot:hover) { transform: scale(1.08); }
  :global(.jstop__dot:focus-visible) { outline: 2px solid #ece4cf; outline-offset: 3px; }
  :global(.jstop.is-active .jstop__dot) { background: #ece4cf; color: #11100d; border-color: #ece4cf; }
  :global(.jstop.is-active .jstop__dot::after) {
    content: ''; position: absolute; inset: -9px; border-radius: 50%; border: 1px solid rgba(236, 228, 207, 0.6);
    animation: jpulse 2.2s cubic-bezier(0.22, 1, 0.36, 1) infinite; pointer-events: none;
  }
  @keyframes jpulse { 0% { transform: scale(0.6); opacity: 1; } 100% { transform: scale(1.5); opacity: 0; } }
  :global(.jstop.is-open .jstop__dot::after) { animation: none; opacity: 0; }
  :global(.jstop__label) {
    display: grid; gap: 2px; pointer-events: none;
    font: 600 12px/1.2 var(--font-sans); letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap;
    color: #d0c5ab; text-shadow: 0 1px 8px rgba(0, 0, 0, 0.95); opacity: 0; transition: opacity 0.5s;
  }
  :global(.jstop__label small) { font-size: 10px; font-weight: 500; letter-spacing: 0.1em; opacity: 0.7; }
  :global(.jstop.is-active .jstop__label) { opacity: 1; }
  :global(.jstop.is-open .jstop__label) { opacity: 0; }

  .ph { outline: 1px dashed currentColor; outline-offset: 2px; }

  /* No WebGL: the map shows the stops as a list */
  .jmap:global(.is-static) .jmap__stage { overflow: auto; padding: 96px var(--gutter) 48px; }
  .jmap:global(.is-static) :is(.jmap__map, .jmap__fog, .jnav, .jctrl, .jmap__hint) { display: none; }
  .jmap:global(.is-static) .jmap__intro { position: relative; background: none; }
  .jmap:global(.is-static) .jpanels { position: relative; display: grid; gap: 16px; max-width: 640px; margin: 32px auto 0; pointer-events: auto; }
  .jmap:global(.is-static) .jcard { position: relative; inset: auto; width: auto; opacity: 1; visibility: visible; transform: none; }
  .jmap:global(.is-static) :is(.jcard__close, .jcard__next) { display: none; }

  /* Phones: a compact card, lifted above the floating pill menu */
  @media (max-width: 640px) { .mapcard:global(.is-compact) { bottom: 20px; } }
  @media (max-width: 640px) {
    .mapcard { width: 140px; right: 12px; bottom: 96px; }
    .mapcard__meta { display: none; }
    .mapcard__title { font-size: 16px; }
    .mapcard__go { width: 26px; height: 26px; }
  }
  @media (max-width: 900px) {
    .jnav { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mapcard { animation: none; opacity: 1; transform: none; }
    .mapcard__pulse { animation: none; }
    :global(.jstop.is-active .jstop__dot::after) { animation: none; }
  }
</style>

<script>
  import { initJourney } from '../scripts/journey';
  initJourney();

  // Tuck the corner card into a small "3D" button once the hero has scrolled away
  const card = document.querySelector<HTMLElement>('.mapcard');
  const hero = document.getElementById('top');
  if (card && hero) {
    new IntersectionObserver(([e]) => card.classList.toggle('is-compact', !e.isIntersecting), { threshold: 0.35 }).observe(hero);
  }
</script>
