---
import { journey, about } from '../content/site';
import Media from './Media.astro';
import { rich, pad } from '../lib/format';
import Chapter from './Chapter.astro';
---

<section id="about" class="section journey" data-theme="paper" data-chapter="2" data-chapter-label="About me" aria-labelledby="about-title">
  <div class="wrap grid about">
    <div class="about__heading">
      <Chapter n={2} label="About me" />
      <h2 id="about-title" class="h-section" data-reveal set:html={rich(about.title)} />
    </div>
    <div class="about__portrait">
      <Media src={about.portrait.src} alt={about.portrait.alt} ratio="tall" />
    </div>
    <div class="about__text">
      {about.bio.map((p, i) => <p data-reveal style={`--d:${i}`} set:html={rich(p)} />)}
      <dl class="about__facts" data-reveal>
        {about.facts.map((f) => (
          <div><dt class="label muted">{f.label}</dt><dd set:html={rich(f.value)} /></div>
        ))}
      </dl>
    </div>
  </div>

  <div class="wrap grid journey__wrap">
    <div class="journey__heading">
      <h3 id="journey-title" class="h-sub display" data-reveal set:html={rich(journey.title)} />
    </div>
    <p class="lede muted journey__intro" data-reveal style="--d:1" set:html={rich(journey.intro)} />

    <div class="journey__aside" aria-hidden="true">
      <div class="journey__stage">
        <span class="label muted">Stage</span>
        <span class="journey__stage-n display"><span data-stage-n>01</span><span class="muted">/{pad(journey.stops.length)}</span></span>
        <span class="journey__stage-label display" data-stage-label>{journey.stops[0].label}</span>
      </div>
    </div>

    <div class="route" data-route style="--progress:0">
      <span class="route__line" aria-hidden="true"><span class="route__fill"></span></span>
      <ol>
      {
        journey.stops.map((stop, i) => (
          <li class="stop" data-stop data-label={stop.label} data-reveal>
            <span class="stop__pin" aria-hidden="true" />
            <div class="stop__head">
              <span class="label stop__n">{pad(i + 1)}</span>
              <span class="label stop__when" set:html={rich(stop.when)} />
              <span class="label stop__tag">{stop.label}</span>
            </div>
            <h4 class="stop__title" set:html={rich(stop.title)} />
            <p class="stop__body muted" set:html={rich(stop.body)} />
            <ul class="chips" aria-label="Skills">
              {stop.skills.map((s) => <li class="chip" set:html={rich(s)} />)}
            </ul>
          </li>
        ))
      }
      </ol>
    </div>
  </div>
</section>

<style>
  .about { row-gap: 40px; }
  .about__heading,
  .about__portrait,
  .about__text { grid-column: 1 / -1; }
  .about__portrait { max-width: 420px; }
  .about__text {
    display: grid;
    gap: 1.1em;
    align-content: start;
    font-size: var(--type-lede);
    line-height: 1.5;
    max-width: 38ch;
  }
  .about__facts {
    display: grid;
    margin-top: 1em;
    border-top: 1px solid var(--line);
    font-size: var(--type-body);
  }
  .about__facts div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
  }
  .journey__wrap { margin-top: clamp(96px, 14vw, 200px); }
  .h-sub { font-size: var(--type-h3); text-wrap: balance; }
  .h-sub :global(em) { font-style: italic; color: var(--accent-text); }
  @media (min-width: 960px) {
    .about__portrait { grid-column: 1 / span 5; }
    .about__text { grid-column: 7 / -1; align-self: end; }
  }

  .journey .grid { row-gap: 32px; align-items: end; }
  .journey__heading,
  .journey__intro { grid-column: 1 / -1; }
  .journey__aside { display: none; }

  .route {
    position: relative;
    grid-column: 1 / -1;
    margin-top: clamp(48px, 8vw, 96px);
    padding-left: 44px;
  }
  .route__line {
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 1px;
    background: var(--line);
  }
  .route__fill {
    position: absolute;
    inset: 0;
    background: var(--pin);
    transform-origin: top;
    transform: scaleY(var(--progress));
  }

  .stop {
    position: relative;
    padding-bottom: clamp(56px, 9vw, 120px);
  }
  .stop:last-child {
    padding-bottom: 0;
  }
  .stop__pin {
    position: absolute;
    left: -44px;
    top: 2px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1.5px solid var(--fg);
    background: var(--bg);
    transition: background 0.4s var(--ease-out), border-color 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }
  .stop__pin::before,
  .stop__pin::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
  }
  .stop__pin::before { width: 7px; height: 1.5px; }
  .stop__pin::after { width: 1.5px; height: 7px; }
  .stop.is-active .stop__pin,
  .stop.is-passed .stop__pin {
    background: var(--pin);
    border-color: var(--pin);
    color: var(--bg);
  }
  .stop.is-active .stop__pin { transform: scale(1.25); }

  .stop__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    margin-bottom: 18px;
  }
  .stop__n { color: var(--accent-text); }
  .stop__tag {
    margin-left: auto;
    color: var(--muted);
  }
  .stop__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--fs-3);
    line-height: 1;
    letter-spacing: -0.015em;
    max-width: 14ch;
    text-wrap: balance;
  }
  .stop__title :global(em) { font-style: italic; }
  .stop__body {
    margin-top: 20px;
    max-width: 46ch;
  }
  .stop .chips { margin-top: 24px; }

  @media (min-width: 960px) {
    .journey__heading { grid-column: 1 / span 7; }
    .journey__intro { grid-column: 9 / -1; }
    .journey__aside {
      display: block;
      grid-column: 1 / span 5;
      align-self: stretch;
      margin-top: clamp(56px, 8vw, 120px);
    }
    .journey__stage {
      position: sticky;
      top: calc(50vh - 120px);
      display: grid;
      gap: 6px;
      padding-top: 24px;
      border-top: 1px solid var(--line);
    }
    .journey__stage-n {
      font-size: var(--type-h3);
    }
    .journey__stage-label {
      font-size: var(--type-h2);
      font-style: italic;
      color: var(--accent-text);
    }
    .route {
      grid-column: 7 / -1;
      margin-top: clamp(56px, 8vw, 120px);
    }
  }
</style>
