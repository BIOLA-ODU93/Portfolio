---
/**
 * Project image. If `src` is empty, renders a clearly labelled placeholder
 * frame showing the recommended size, so you know exactly what to export.
 */
import { plain } from '../lib/format';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  ratio?: 'wide' | 'tall' | 'square';
  eager?: boolean;
}
const { src, alt, caption, ratio = 'wide', eager = false } = Astro.props;
const size = { wide: '2400 × 1500 px (16:10)', tall: '1600 × 2000 px (4:5)', square: '1800 × 1800 px (1:1)' }[ratio];
const altText = plain(alt);
---

<figure class={`media media--${ratio}`} data-reveal>
  {
    src ? (
      <img src={src} alt={altText} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <div class="media__ph" role="img" aria-label={`Image placeholder: ${altText}`}>
        <svg class="media__cross" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <line x1="0" y1="0" x2="100" y2="100" vector-effect="non-scaling-stroke" />
          <line x1="100" y1="0" x2="0" y2="100" vector-effect="non-scaling-stroke" />
        </svg>
        <span class="media__ph-text">
          <span class="label">Image placeholder</span>
          <span class="media__ph-alt">{altText}</span>
          <span class="label muted">{size}</span>
        </span>
      </div>
    )
  }
  {caption && <figcaption class="label muted">{plain(caption)}</figcaption>}
</figure>

<style>
  .media { display: grid; gap: 12px; }
  .media img,
  .media__ph {
    width: 100%;
    object-fit: cover;
    background: var(--night-2);
  }
  .media--wide img, .media--wide .media__ph { aspect-ratio: 16 / 10; }
  .media--tall img, .media--tall .media__ph { aspect-ratio: 4 / 5; }
  .media--square img, .media--square .media__ph { aspect-ratio: 1 / 1; }

  .media__ph {
    position: relative;
    display: grid;
    place-items: center;
    border: 1px dashed var(--line);
    background:
      radial-gradient(60% 60% at 70% 30%, rgba(159, 191, 212, 0.1), transparent 70%),
      color-mix(in srgb, var(--fg) 4%, var(--bg));
    overflow: hidden;
  }
  .media__cross {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: var(--line);
    stroke-width: 1;
  }
  .media__ph-text {
    position: relative;
    display: grid;
    gap: 8px;
    justify-items: center;
    text-align: center;
    padding: 20px 24px;
    background: var(--bg);
    border: 1px solid var(--line);
    max-width: 80%;
  }
  .media__ph-text .label:first-child { color: var(--accent-text); }
  .media__ph-alt {
    font-family: var(--font-display);
    font-size: var(--type-lede);
    line-height: 1.15;
  }
</style>
