---
/**
 * A tidy phone mockup for 390-wide app screenshots: bezel, status bar with a Dynamic Island,
 * the screen at its true proportions (never cropped), and a home-indicator strip.
 * Everything is sized in container units, so it scales cleanly at any width.
 */
interface Props {
  src: string;
  alt: string;
  time?: string;       // status-bar time, to match the screen's own clock
  wifi?: boolean;      // false = on mobile data (no Wi-Fi icon)
  top?: string;        // colour behind the status bar (the screen's background)
  bottom?: string;     // colour of the home-indicator strip (the screen's tab bar)
  eager?: boolean;
}
const { src, alt, time = '9:41', wifi = true, top = '#fafafe', bottom = top, eager = false } = Astro.props;
---

<div class="phone" style={`--top: ${top}; --bottom: ${bottom}`}>
  <div class="phone__body">
  <div class="phone__screen">
    <div class="phone__status" aria-hidden="true">
      <span class="phone__time">{time}</span>
      <span class="phone__island"></span>
      <span class="phone__icons">
        <svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="0.8" /><rect x="5" y="5.5" width="3" height="6.5" rx="0.8" /><rect x="10" y="3" width="3" height="9" rx="0.8" /><rect x="15" y="0" width="3" height="12" rx="0.8" /></svg>
        {wifi
          ? <svg viewBox="0 0 16 12"><path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0zM3.5 6.9a6.4 6.4 0 0 1 9 0l-1.4 1.4a4.4 4.4 0 0 0-6.2 0zM1.3 4.6a9.6 9.6 0 0 1 13.4 0l-1.4 1.4a7.6 7.6 0 0 0-10.6 0z" /></svg>
          : <span class="phone__net">5G</span>}
        <svg viewBox="0 0 27 12"><rect x="0.5" y="0.5" width="23" height="11" rx="3.2" fill="none" stroke="currentColor" stroke-opacity="0.4" /><rect x="2.5" y="2.5" width="16" height="7" rx="1.6" /><path d="M25 4v4a2 2 0 0 0 0-4z" fill-opacity="0.45" /></svg>
      </span>
    </div>
    <img src={src} alt={alt} width="390" height="844" loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
    <div class="phone__home" aria-hidden="true"><span></span></div>
  </div>
  </div>
</div>

<style>
  /* .phone is the size container; the body measures itself against it (cqw = 1% of the phone's width) */
  .phone { container-type: inline-size; width: 100%; }
  .phone__body {
    padding: 3.4cqw;
    border-radius: 14cqw;
    background: linear-gradient(160deg, #2a2e36, #15171c 45%, #1d2027);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), inset 0 0 0 2px #0c0d10, 0 40px 80px -30px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(0, 0, 0, 0.6);
  }
  .phone__screen { display: flex; flex-direction: column; overflow: hidden; border-radius: 10.8cqw; background: var(--top); }
  .phone__status { position: relative; display: flex; align-items: center; justify-content: space-between; height: 12.5cqw; padding: 0 7.5cqw 0 9.5cqw; background: var(--top); color: #101114; font: 600 4.1cqw/1 -apple-system, 'SF Pro Text', 'Inter', system-ui, sans-serif; letter-spacing: -0.01em; }
  .phone__island { position: absolute; left: 50%; top: 2.6cqw; width: 30cqw; height: 8.4cqw; translate: -50% 0; border-radius: 99px; background: #050506; }
  .phone__icons { display: flex; align-items: center; gap: 1.5cqw; }
  .phone__icons svg { height: 3cqw; width: auto; fill: currentColor; }
  .phone__icons svg:last-child { height: 3.1cqw; }
  .phone__net { font-size: 3.3cqw; font-weight: 600; }
  .phone img { display: block; width: 100%; height: auto; }
  .phone__home { display: grid; place-items: center; height: 6.5cqw; background: var(--bottom); }
  .phone__home span { width: 34cqw; height: 1.35cqw; border-radius: 99px; background: #101114; opacity: 0.85; }
</style>
