---
import type { Project } from '../content/site';
import { rich, plain, pad } from '../lib/format';
import Media from './Media.astro';
import Arrow from './Arrow.astro';

interface Props { project: Project; index: number; total: number }
const { project: p, index, total } = Astro.props;
const [lead, ...rest] = p.media;
const showOutcomesHint = import.meta.env.DEV && p.outcomes.length === 0;
---

<article id={p.slug} class="case" aria-labelledby={`${p.slug}-title`}>
  <header class="case__head">
    <p class="label case__count muted" data-reveal>
      <span class="case__n">{pad(index + 1)}</span> / {pad(total)}
    </p>
    <h4 id={`${p.slug}-title`} class="case__title display" data-reveal set:html={rich(p.name)} />
    <dl class="case__meta label" data-reveal style="--d:1">
      <div><dt class="muted">Year</dt><dd set:html={rich(p.year)} /></div>
      <div><dt class="muted">Discipline</dt><dd set:html={rich(p.discipline)} /></div>
      <div><dt class="muted">Role</dt><dd set:html={rich(p.role)} /></div>
    </dl>
    {
      p.liveUrl && (
        <a class="btn case__live" href={p.liveUrl} target="_blank" rel="noopener noreferrer" data-reveal style="--d:2">
          Visit live site <Arrow dir="up-right" />
          <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      )
    }
  </header>

  {lead && <div class="case__lead"><Media {...lead} /></div>}

  <div class="case__body grid">
    <p class="case__summary" data-reveal set:html={rich(p.summary)} />

    <dl class="case__facts">
      <div class="fact" data-reveal>
        <dt class="label muted">The challenge</dt>
        <dd set:html={rich(p.challenge)} />
      </div>
      <div class="fact" data-reveal>
        <dt class="label muted">My contribution</dt>
        <dd>
          <ul class="case__list">
            {p.contribution.map((c) => <li set:html={rich(c)} />)}
          </ul>
        </dd>
      </div>
      <div class="fact" data-reveal>
        <dt class="label muted">Design story</dt>
        <dd class="case__story">
          {p.story.map((para) => <p set:html={rich(para)} />)}
        </dd>
      </div>
      {
        p.outcomes.length > 0 && (
          <div class="fact" data-reveal>
            <dt class="label muted">Outcomes</dt>
            <dd>
              <ul class="case__list">
                {p.outcomes.map((o) => <li set:html={rich(o)} />)}
              </ul>
            </dd>
          </div>
        )
      }
      {
        showOutcomesHint && (
          <div class="fact fact--hint">
            <dt class="label muted">Outcomes</dt>
            <dd><span class="ph">Only visible while editing: add real outcomes in site.ts, or leave empty to hide this row.</span></dd>
          </div>
        )
      }
    </dl>
  </div>

  {
    rest.length > 0 && (
      <div class="case__gallery">
        {rest.map((m) => (
          <div class={`case__cell case__cell--${m.ratio ?? 'wide'}`}>
            <Media {...m} />
          </div>
        ))}
      </div>
    )
  }

  <p class="case__tags">
    <span class="visually-hidden">Tags for {plain(p.name)}:</span>
    {p.tags.map((t) => <span class="chip">{t}</span>)}
  </p>
</article>

<style>
  .case {
    padding-block: clamp(80px, 12vw, 180px);
    border-top: 1px solid var(--line);
  }
  .case__head {
    display: grid;
    gap: 24px;
    margin-bottom: clamp(32px, 5vw, 64px);
  }
  .case__n { color: var(--accent-text); }
  .case__title {
    font-size: var(--fs-5);
    text-wrap: balance;
  }
  .case__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
  }
  .case__meta div { display: grid; gap: 4px; }
  .case__meta dd { text-transform: none; letter-spacing: 0.02em; font-size: var(--type-small); }
  .case__live { justify-self: start; }

  .case__body {
    margin-top: clamp(40px, 6vw, 88px);
    row-gap: 40px;
  }
  .case__summary {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-size: var(--type-h4);
    line-height: 1.15;
    text-wrap: balance;
  }
  .case__facts {
    grid-column: 1 / -1;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .fact {
    display: grid;
    gap: 12px;
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
  }
  .fact dd { max-width: 60ch; }
  .case__story { display: grid; gap: 1em; }
  .case__list li {
    position: relative;
    padding-left: 22px;
  }
  .case__list li + li { margin-top: 6px; }
  .case__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 1px;
    background: var(--pin);
  }

  .case__gallery {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
    margin-top: clamp(40px, 6vw, 88px);
    align-items: start;
  }
  .case__cell { grid-column: 1 / -1; }

  .case__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 40px;
  }

  @media (min-width: 760px) {
    .case__cell--tall { grid-column: span 5; }
    .case__cell--square { grid-column: span 7; }
    .case__cell--tall + .case__cell--square { margin-top: clamp(40px, 10vw, 160px); }
  }

  @media (min-width: 960px) {
    .case__head {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: end;
    }
    .case__count { grid-column: 1 / -1; }
    .case__title { grid-column: 1 / span 8; }
    .case__meta { grid-column: 9 / -1; justify-content: flex-end; flex-direction: column; gap: 14px; }
    .case__meta div { grid-template-columns: 7rem 1fr; }
    .case__live { grid-column: 9 / -1; }

    .case__summary { grid-column: 1 / span 5; position: sticky; top: calc(var(--header-h) + 32px); align-self: start; }
    .case__facts { grid-column: 7 / -1; }
    .fact { grid-template-columns: 10rem 1fr; gap: var(--gutter); }
  }
</style>
