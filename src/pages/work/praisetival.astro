---
/**
 * Case study — Praisetival Ireland. Copy and images: src/content/work.ts.
 * Motion: a cinematic opening (the site shrinks into a frame), a pinned
 * "key decisions" scene, live countdown, tilting phones, counting results.
 * Reduced motion: everything is shown statically, in reading order.
 */
import Base from '../../layouts/Base.astro';
import ContactSheet from '../../components/ContactSheet.astro';
import MinisterCards from '../../components/MinisterCards.astro';
import { praisetival as cs } from '../../content/work';
import { site } from '../../content/site';
import '../../styles/case-study.css';

const ph = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\[(.+?)\]/g, '<span class="ph">$1</span>');
---

<Base title={`${cs.client} — case study · ${site.displayName}`} description={cs.summary}>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@500;600&family=Playfair+Display:ital@1&display=swap" />
  <header class="cs-bar" data-cs-bar>
    <a class="cs-bar__logo" href="/"><img src="/brand/signature.png" alt={`${site.displayName} — home`} width="115" height="88" /></a>
    <a class="cs-bar__back label" href="/">← Back to portfolio</a>
  </header>

  <main id="main" tabindex="-1" class="cs" data-cs>
    <!-- 1 · Cinematic opening -->
    <section class="cs-intro" data-cs-intro aria-labelledby="cs-title">
      <div class="cs-intro__stage">
        <div class="cs-intro__copy">
          <p class="label cs-kicker">{cs.kicker} · {cs.client}</p>
          <h1 id="cs-title" class="cs-intro__title">{cs.title}</h1>
        </div>
        <!-- the live site's hero, rebuilt: real video, real countdown -->
        <figure class="cs-intro__screen" aria-label={`${cs.client} home page, as live`}>
          <div class="pv">
            <video class="pv__video" src={cs.live.video} muted loop playsinline preload="auto" aria-hidden="true"></video>
            <div class="pv__shade" aria-hidden="true"></div>
            <div class="pv__nav" aria-hidden="true">
              <img src={cs.live.logo} alt="" width="197" height="57" />
              <span class="pv__nav-right"><span class="pv__tickets">Get Tickets ↗</span><span class="pv__burger"><i></i><i></i></span></span>
            </div>
            <div class="pv__body">
              <p class="pv__title">The <em>Sound</em><br />of a Generation<br />that Believes</p>
              <div class="pv__card">
                <img src={cs.live.event.thumb} alt="" width="98" height="110" />
                <div class="pv__card-text">
                  <p class="pv__event">{cs.live.event.name}</p>
                  <p class="pv__count" data-live-count={cs.live.event.at} data-fallback={cs.live.event.label}>&nbsp;</p>
                  <p class="pv__more">View More <span>→</span></p>
                </div>
              </div>
              <p class="pv__play">Press play to watch our story <span>▶</span></p>
            </div>
          </div>
        </figure>
        <p class="cs-intro__tag label" aria-hidden="true">Case study · {cs.client}</p>
        <p class="cs-intro__hint label" aria-hidden="true">Scroll</p>
      </div>
    </section>

    <!-- 2 · At a glance (plain and instant) -->
    <section class="cs-sec cs-glance">
      <p class="cs-summary" data-reveal>{cs.summary}</p>
      <dl class="cs-meta" data-reveal>
        {cs.meta.map((m) => (
          <div><dt class="label">{m.k}</dt><dd>{m.href ? <a href={m.href} target="_blank" rel="noopener">{m.v} ↗</a> : m.v}</dd></div>
        ))}
      </dl>
      <p class="label cs-label">At a glance</p>
      <div class="cs-cols">
        {cs.glance.map((g) => (
          <div class="cs-col" data-reveal><h2 class="cs-h3">{g.k}</h2><p>{g.v}</p></div>
        ))}
      </div>
    </section>

    <!-- 3 · Context -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>The context</p>
      <h2 class="cs-h2" data-reveal>{cs.context.title}</h2>
      <p class="cs-lede" data-reveal>{cs.context.text}</p>
      <div class="cs-cards">
        {cs.context.constraints.map((c) => (
          <div class="cs-card" data-reveal><p class="label">{c.k}</p><p>{c.v}</p></div>
        ))}
      </div>
    </section>

    <!-- 4 · Goals -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>What success looked like</p>
      <h2 class="cs-h2" data-reveal>Three goals for the redesign</h2>
      <ol class="cs-cols cs-goals">
        {cs.goals.map((g, i) => (
          <li class="cs-col" data-reveal><span class="cs-num">0{i + 1}</span><h3 class="cs-h3">{g.k}</h3><p>{g.v}</p></li>
        ))}
      </ol>
    </section>

    <!-- 5 · Process + site map -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>The process</p>
      <h2 class="cs-h2" data-reveal>{cs.process.title}</h2>
      <p class="cs-lede" data-reveal>{cs.process.text}</p>
      <ol class="cs-steps">
        {cs.process.steps.map((s, i) => (
          <li data-reveal><span class="cs-num">0{i + 1}</span><h3 class="cs-h4">{s.k}</h3><p>{s.v}</p></li>
        ))}
      </ol>
      <figure class="cs-map" data-reveal data-map>
        <figcaption class="label">Site map</figcaption>
        <div class="cs-map__root"><span class="cs-node">{cs.process.sitemap.root}</span></div>
        <svg class="cs-map__lines" viewBox="0 0 800 120" preserveAspectRatio="none" aria-hidden="true">
          <path d="M400 0 V40 M100 40 H700 M100 40 V80 M300 40 V80 M500 40 V80 M700 40 V80" />
          <path d="M400 92 V120" />
        </svg>
        <div class="cs-map__pages">{cs.process.sitemap.pages.map((p) => <span class="cs-node">{p}</span>)}</div>
        <div class="cs-map__action"><span class="cs-node cs-node--primary">{cs.process.sitemap.action}</span></div>
        <p class="cs-map__note">Every page ends in the same place: the primary action.</p>
      </figure>
    </section>

    <!-- 6 · Key decisions (pinned scene) -->
    <section class="cs-decisions" data-cs-decisions aria-labelledby="kd-title" style={`--steps: ${cs.decisions.length}`}>
      <div class="cs-decisions__stage">
        <div class="cs-decisions__text">
          <p class="label cs-label">Key decisions</p>
          <h2 id="kd-title" class="cs-h2 cs-decisions__title">Three calls that shaped the site</h2>
          <ol class="cs-dots" aria-hidden="true">{cs.decisions.map((_, i) => <li data-dot>0{i + 1}</li>)}</ol>
          <div class="cs-steps-text">
            {cs.decisions.map((d, i) => (
              <article class="cs-step" data-step>
                <h3 class="cs-h3"><span class="cs-num">0{i + 1}</span> {d.title}</h3>
                <dl>
                  <div><dt class="label">Problem</dt><dd>{d.problem}</dd></div>
                  <div><dt class="label">Decision</dt><dd>{d.decision}</dd></div>
                  <div><dt class="label">Why it works</dt><dd>{d.why}</dd></div>
                </dl>
                {d.lineup && (
                  <div class="cs-step__demo">
                    <p class="label">Try it · press + on a card</p>
                    <MinisterCards cards={d.lineup} />
                  </div>
                )}
                {i === 0 && (
                  <div class="cs-live" aria-label="The countdown, rebuilt in code">
                    <p class="label">Live · rebuilt in code, counting to the real event</p>
                    <p class="cs-live__time" aria-hidden="true"><span>{cs.live.event.name}</span> <span data-live-count={cs.live.event.at} data-fallback={cs.live.event.label}>&nbsp;</span></p>
                  </div>
                )}
              </article>
            ))}
          </div>
        </div>
        <div class="cs-screen" data-screen>
          {cs.decisions.map((d) => (
            <div
              class:list={['cs-layer', d.pan ? 'cs-layer--pan' : 'cs-layer--zoom']}
              data-layer
              style={d.focus ? `--s: ${d.focus.scale}; --fx: ${d.focus.x}; --fy: ${d.focus.y}` : undefined}
            >
              {d.lineup
                ? <div class="cs-pan"><MinisterCards cards={d.lineup} /></div>
                : <img class={d.pan ? 'cs-pan' : undefined} src={d.image} alt={`Screen: ${d.title}`} loading="lazy" decoding="async" />}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7 · Mobile -->
    <section class="cs-sec cs-mobile" data-phones>
      <p class="label cs-label" data-reveal>Responsive</p>
      <h2 class="cs-h2" data-reveal>{cs.mobile.title}</h2>
      <p class="cs-lede" data-reveal>{cs.mobile.text}</p>
      <div class="cs-phones">
        {cs.mobile.phones.map((p, i) => (
          <figure class="cs-phone" data-reveal style={`--start: ${(p.start / cs.mobile.pageHeight) * 100}%; --i: ${i}`}>
            <div class="cs-phone__frame" data-tilt>
              <div class="cs-phone__screen"><img src={cs.mobile.image} alt={`Mobile: ${p.cap}`} loading="lazy" decoding="async" /></div>
            </div>
            <figcaption>{p.cap}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- 8 · Outcome -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>The outcome</p>
      <h2 class="cs-h2" data-reveal>{cs.outcome.title}</h2>
      <p class="cs-lede" data-reveal>{cs.outcome.text}</p>
      <ul class="cs-stats" data-count-up>
        {cs.outcome.stats.map((s) => (
          <li class="cs-stat" data-reveal>
            <span class="cs-stat__value"><span data-count={s.value}>{s.value}</span>{s.unit && <span class="cs-stat__unit"> {s.unit}</span>}</span>
            <span>{s.label}</span>
          </li>
        ))}
        <li class="cs-stat cs-stat--ph" data-reveal set:html={ph(cs.outcome.placeholder)} />
      </ul>
    </section>

    <!-- 9 · Reflection -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>Looking back</p>
      <h2 class="cs-h2" data-reveal>What I’d do differently</h2>
      <div class="cs-cols cs-cols--2">
        {cs.reflection.map((r) => (
          <div class="cs-col" data-reveal><h3 class="cs-h3">{r.k}</h3><p>{r.v}</p></div>
        ))}
      </div>
    </section>

    <!-- 10 · Next -->
    <section class="cs-next">
      <p class="label">Thanks for reading</p>
      <a class="cs-next__link" href="/">Back to the portfolio <span aria-hidden="true">→</span></a>
      <button class="cs-next__talk label" type="button" data-contact-open>Let’s talk</button>
    </section>
  </main>
  <ContactSheet />
</Base>

<style>
  .cs-h2 { margin: 0; max-width: 18ch; font-family: var(--font-display); font-weight: var(--fw-display); font-size: clamp(2rem, 1.2rem + 2.6vw, 3.6rem); line-height: 1.05; letter-spacing: var(--tracking-display); }
  .cs-intro { position: relative; height: 240vh; --p: 0; }
  .cs-intro__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .cs-intro__screen {
    /* shrinks first (p 0.08 → 0.62), to a size that always leaves room for the title */
    --e: clamp(0, (var(--p) - 0.08) / 0.54, 1);
    --ar: 0.5938; /* height / width of the screen image */
    --fw: min(1100px, 88vw, calc((100svh - 300px) / var(--ar)));
    --fh: calc(var(--fw) * var(--ar));
    position: absolute; left: 50%; top: 0; margin: 0;
    width: calc(100vw - (100vw - var(--fw)) * var(--e));
    height: calc(100svh - (100svh - var(--fh)) * var(--e));
    translate: -50% calc(var(--e) * (100svh - var(--fh) - 32px));
    border-radius: calc(var(--e) * 18px);
    overflow: hidden;
    box-shadow: 0 40px 120px -40px rgba(0, 0, 0, calc(var(--e) * 0.9));
    outline: 1px solid rgba(208, 197, 171, calc(var(--e) * 0.12));
  }
  .pv { position: absolute; inset: 0; container-type: size; overflow: hidden; background: #111; color: #fff; font-family: Figtree, var(--font-sans); }
  .pv__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pv__shade { position: absolute; inset: 0; background: linear-gradient(rgba(15, 15, 15, 0.4), rgba(0, 0, 0, 0) 50%, rgba(15, 15, 15, 0.85)), rgba(0, 0, 0, 0.4); }
  .pv__nav { position: absolute; inset: 0 0 auto 0; display: flex; justify-content: space-between; align-items: center; padding: 2.4cqw 3.3cqw; }
  .pv__nav img { width: clamp(64px, 11cqw, 170px); height: auto; }
  .pv__nav-right { display: flex; align-items: center; gap: 2cqw; }
  .pv__tickets { padding: 0.9cqw 1.8cqw; border-radius: 999px; background: #fff; color: #111; font-size: clamp(8px, 1cqw, 14px); font-weight: 600; white-space: nowrap; }
  .pv__burger { display: grid; gap: 0.5cqw; width: 2cqw; min-width: 12px; }
  .pv__burger i { display: block; height: 2px; background: #fff; border-radius: 2px; }
  .pv__body { position: absolute; inset: auto 0 0 0; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 1.6cqw 3cqw; padding: 0 3.3cqw 3cqw; }
  .pv__title { margin: 0; grid-column: 1; font-weight: 600; font-size: clamp(18px, 5.4cqw, 78px); line-height: 1.06; letter-spacing: -0.025em; }
  .pv__title em { font-family: 'Playfair Display', Georgia, serif; font-weight: 400; font-style: italic; }
  .pv__card { grid-column: 2; grid-row: 1 / span 2; align-self: end; display: flex; gap: 1.2cqw; width: clamp(180px, 34cqw, 480px); padding: 0.9cqw; border-radius: 1.2cqw; background: #fff; color: #010101; box-shadow: 0 1.4cqw 4cqw rgba(0, 0, 0, 0.35); }
  .pv__card img { width: 22%; aspect-ratio: 98 / 110; height: auto; object-fit: cover; border-radius: 0.5cqw; }
  .pv__card-text { display: grid; align-content: space-between; flex: 1; min-width: 0; }
  .pv__event { margin: 0; font-weight: 600; font-size: clamp(9px, 1.6cqw, 22px); text-transform: uppercase; line-height: 1.1; }
  .pv__count { margin: 0.3cqw 0 0; font-weight: 500; font-size: clamp(7px, 0.95cqw, 13px); color: #595959; letter-spacing: 0.04em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pv__more { margin: 0; display: flex; justify-content: space-between; font-size: clamp(7px, 1.1cqw, 15px); color: #595959; }
  .pv__play { margin: 0; grid-column: 1; font-weight: 500; font-size: clamp(7px, 0.95cqw, 13px); letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.9; }
  .pv__play span { display: inline-grid; place-items: center; width: 2.6cqw; height: 2.6cqw; min-width: 16px; min-height: 16px; margin-left: 0.6em; border: 1px solid rgba(255, 255, 255, 0.6); border-radius: 50%; font-size: 0.7em; }
  @container (max-aspect-ratio: 1) {
    .pv__nav { padding: 5cqw 6cqw; }
    .pv__nav img { width: 30cqw; }
    .pv__tickets { display: none; }
    .pv__burger { width: 6cqw; gap: 1.4cqw; }
    .pv__body { grid-template-columns: 1fr; gap: 4cqw; padding: 0 6cqw 7cqw; }
    .pv__title { font-size: 10cqw; }
    .pv__card { grid-column: 1; grid-row: auto; width: 100%; gap: 3cqw; padding: 2.4cqw; border-radius: 3cqw; }
    .pv__card img { border-radius: 1.4cqw; }
    .pv__event { font-size: 4.4cqw; }
    .pv__count { font-size: 2.8cqw; }
    .pv__more { font-size: 3.2cqw; }
    .pv__play { font-size: 2.8cqw; }
    .pv__play span { width: 7cqw; height: 7cqw; }
  }
  @media (max-width: 640px) {
    .cs-intro__screen { --ar: 1.6114; --fw: min(76vw, calc((100svh - 400px) / var(--ar))); }
    .cs-intro__copy { padding-top: 92px; }
    .cs-intro__tag { display: none; }
    .cs-intro__title { font-size: clamp(1.7rem, 7.4vw, 2.2rem); }
  }
  .cs-intro__copy {
    --c: clamp(0, (var(--p) - 0.5) / 0.3, 1);
    position: absolute; left: 0; right: 0; top: 0; z-index: 1;
    padding: clamp(96px, 13svh, 140px) var(--pad) 0;
    opacity: var(--c); translate: 0 calc((1 - var(--c)) * 30px);
  }
  .cs-intro__title { margin: 14px 0 0; max-width: 20ch; font-family: var(--font-display); font-weight: var(--fw-display); font-size: clamp(2.1rem, 1rem + 3.6vw, 4.6rem); line-height: 1.02; letter-spacing: var(--tracking-display); text-wrap: balance; }
  .cs-intro__tag { position: absolute; left: var(--gutter); bottom: 28px; z-index: 1; padding: 8px 14px; border-radius: 999px; background: rgba(17, 16, 13, 0.7); color: var(--fog); opacity: calc(1 - var(--p) * 8); }
  .cs-intro__hint { position: absolute; left: 50%; bottom: 28px; translate: -50% 0; color: var(--fog); opacity: calc(1 - var(--p) * 6); animation: hint 2.4s var(--ease-in-out) infinite; }
  @keyframes hint { 50% { translate: -50% 8px; } }
  .cs-map { display: grid; justify-items: center; gap: 0; margin: 24px 0 0; padding: clamp(24px, 4vw, 48px); border-radius: 16px; background: var(--night-2); }
  .cs-map figcaption { margin-bottom: 20px; }
  .cs-map__lines { width: min(800px, 100%); height: 60px; }
  .cs-map__lines path { fill: none; stroke: rgba(208, 197, 171, 0.35); stroke-width: 1.5; vector-effect: non-scaling-stroke; stroke-dasharray: 2000; stroke-dashoffset: 2000; transition: stroke-dashoffset 1.6s var(--ease-out) 0.3s; }
  .cs-map:global(.is-in) .cs-map__lines path { stroke-dashoffset: 0; }
  .cs-map__pages { display: grid; grid-template-columns: repeat(4, 1fr); width: min(800px, 100%); justify-items: center; gap: 8px; }
  .cs-map__action { margin-top: 28px; }
  .cs-map__note { margin-top: 18px; color: var(--dim); font-size: var(--type-small); }
  @media (max-width: 640px) { .cs-map__pages { grid-template-columns: 1fr 1fr; row-gap: 12px; } .cs-map__lines { display: none; } }
  .cs-live { justify-self: start; padding: 14px 18px; border-radius: 12px; background: #fff; color: #111; }
  .cs-live .label { color: #6a7480; }
  .cs-live__time { display: grid; gap: 2px; margin-top: 4px; font-weight: 600; font-size: 15px; letter-spacing: 0.02em; font-variant-numeric: tabular-nums; }
  .cs-live__time span:first-child { text-transform: uppercase; font-size: 13px; color: #6a7480; }
  @media (max-width: 900px) {
    .cs-step__demo :global(.mc) { border-radius: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-intro { height: auto; --p: 1; }
    .cs-intro__stage { position: relative; height: auto; display: grid; gap: 32px; padding-bottom: 40px; }
    .cs-intro__copy { position: relative; }
    .cs-intro__screen { position: relative; left: auto; translate: none; width: min(1100px, 88vw); height: auto; margin: 0 auto; aspect-ratio: 1440 / 855; border-radius: 18px; }
    .cs-intro__hint, .cs-intro__tag { display: none; }
  }
</style>

<script>
  import { initCaseStudy } from '../../scripts/case-study';
  initCaseStudy();
</script>
