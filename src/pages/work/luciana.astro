---
/**
 * Case study — Luciana. Copy and images: src/content/work.ts (`luciana`).
 * Interactions: the wordmark parts as the monitor rises (opening), a quote that
 * lights word by word, research rings that count up, a user flow that draws its
 * try-on path, a pinned Discover → Consider → Visualize scene ending in the live
 * site's try-on panel (rebuilt), and a type tester with copyable colours.
 */
import Base from '../../layouts/Base.astro';
import ContactSheet from '../../components/ContactSheet.astro';
import { luciana as cs } from '../../content/work';
import { site } from '../../content/site';
import '../../styles/case-study.css';

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const ph = (s: string) => esc(s).replace(/\[(.+?)\]/g, '<span class="ph">$1</span>');
/** words for the scroll reveal; *starred* runs become accent words */
const words = (s: string) => {
  let on = false;
  return s.split(/\s+/).map((w) => {
    if (w.startsWith('*')) on = true;
    const html = `<span class="w${on ? ' w--em' : ''}">${esc(w.replace(/\*/g, ''))}</span>`;
    if (/\*[.,]?$/.test(w)) on = false;
    return html;
  }).join(' ');
};
const letters = 'LUCIANA'.split('');
const R = 54, C = 2 * Math.PI * R;

// user flow: nodes (viewBox 1000 × 560) and edges; `hot` = the try-on path
const N: Record<string, { x: number; y: number; t: string; hot?: boolean; key?: boolean }> = {
  splash: { x: 70, y: 290, t: 'Splash' }, home: { x: 205, y: 290, t: 'Home' },
  login: { x: 345, y: 70, t: 'Log In' }, signup: { x: 345, y: 140, t: 'Sign Up' }, discover: { x: 345, y: 215, t: 'Discover' },
  wishlist: { x: 345, y: 375, t: 'Wishlist' }, account: { x: 345, y: 460, t: 'Account' },
  arrivals: { x: 500, y: 180, t: 'New Arrivals' }, orders: { x: 500, y: 505, t: 'Order History' },
  shop: { x: 545, y: 300, t: 'Shop', hot: true },
  plp: { x: 820, y: 95, t: 'Product Listing', hot: true }, tryon: { x: 850, y: 195, t: 'AI Try-On', hot: true, key: true },
  pdp: { x: 820, y: 360, t: 'Product Detail', hot: true }, cart: { x: 820, y: 470, t: 'Cart & Checkout', hot: true },
};
const E: [string, string, boolean?][] = [
  ['splash', 'home'], ['home', 'login'], ['home', 'signup'], ['home', 'discover'], ['home', 'wishlist'], ['home', 'account'],
  ['discover', 'arrivals'], ['account', 'orders'], ['arrivals', 'shop'],
  ['home', 'shop', true], ['shop', 'plp', true], ['shop', 'tryon', true], ['shop', 'pdp', true], ['shop', 'cart', true],
];
const curve = (a: string, b: string) => {
  const p = N[a], q = N[b], mx = (p.x + q.x) / 2;
  return `M${p.x} ${p.y} C${mx} ${p.y} ${mx} ${q.y} ${q.x} ${q.y}`;
};
const travel = `${curve('home', 'shop')} ${curve('shop', 'tryon').replace(/^M[\d.]+ [\d.]+/, '')}`;
---

<Base title={`${cs.client} — case study · ${site.displayName}`} description={cs.summary}>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@300;400;500;600;700&display=swap" />
  <header class="cs-bar" data-cs-bar>
    <a class="cs-bar__logo" href="/"><img src="/brand/signature.png" alt={`${site.displayName} — home`} width="115" height="88" /></a>
    <a class="cs-bar__back label" href="/#product">← All work</a>
  </header>

  <main id="main" tabindex="-1" class="cs lu" data-cs>
    <!-- 1 · Opening: the wordmark parts, the monitor rises -->
    <section class="lu-intro" data-cs-intro aria-labelledby="cs-title">
      <div class="lu-intro__stage">
        <p class="lu-word" aria-hidden="true">{letters.map((l, i) => <span style={`--i: ${i - (letters.length - 1) / 2}`}>{l}</span>)}</p>
        <div class="lu-intro__copy">
          <p class="label cs-kicker">{cs.kicker} · {cs.client}</p>
          <h1 id="cs-title" class="lu-intro__title">{cs.title}</h1>
        </div>
        <img class="lu-intro__device" src="/images/work/luciana/monitor.webp" alt="Luciana’s home page on a large monitor" width="1090" height="694" fetchpriority="high" />
        <p class="lu-intro__hint label" aria-hidden="true">Scroll</p>
      </div>
    </section>

    <!-- 2 · At a glance -->
    <section class="cs-sec cs-glance">
      <p class="cs-summary" data-reveal>{cs.summary}</p>
      <dl class="cs-meta" data-reveal>
        {cs.meta.map((m) => <div><dt class="label">{m.k}</dt><dd>{m.href ? <a href={m.href} target="_blank" rel="noopener">{m.v} ↗</a> : m.v}</dd></div>)}
      </dl>
      <p class="label cs-label">At a glance</p>
      <div class="cs-cols">{cs.glance.map((g) => <div class="cs-col" data-reveal><h2 class="cs-h3">{g.k}</h2><p>{g.v}</p></div>)}</div>
    </section>

    <!-- 3 · Problem → the quote lights up word by word -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>Problem statement</p>
      <p class="cs-lede" data-reveal>{cs.problem.text}</p>
      <blockquote class="lu-quote" data-words set:html={words(cs.problem.quote)} />
    </section>

    <!-- 4 · Solution -->
    <section class="cs-sec lu-solution">
      <div class="lu-solution__text">
        <p class="label cs-label" data-reveal>The solution</p>
        <h2 class="cs-h2" data-reveal>Try-on, right where doubt creeps in</h2>
        <p class="cs-lede" data-reveal>{cs.solution}</p>
      </div>
      <img class="lu-float" src="/images/work/luciana/phone-tilt.webp" alt="Luciana product page on a phone, with the Try It On button under the product" width="1182" height="937" loading="lazy" data-reveal />
    </section>

    <!-- 5 · Goals -->
    <section class="cs-sec lu-goals">
      <div>
        <p class="label cs-label" data-reveal>Project goals</p>
        <h2 class="cs-h2" data-reveal>Three goals shaped every decision</h2>
        <ol class="lu-goals__list">
          {cs.goals.map((g, i) => <li data-reveal><span class="cs-num">0{i + 1}</span><h3 class="cs-h4">{g.k}</h3><p>{g.v}</p></li>)}
        </ol>
      </div>
      <img class="lu-goals__img" src="/images/work/luciana/laptop.webp" alt="Luciana’s home page on a laptop" width="622" height="467" loading="lazy" data-reveal />
    </section>

    <!-- 6 · Research: rings count up -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>Research</p>
      <h2 class="cs-h2" data-reveal>{cs.research.title}</h2>
      <p class="cs-lede" data-reveal set:html={ph(cs.research.note)} />
      <ul class="lu-rings" data-count-up>
        {cs.research.stats.map((s) => (
          <li class="lu-ring" data-reveal style={`--v: ${s.value}`}>
            <svg viewBox="0 0 128 128" aria-hidden="true">
              <circle cx="64" cy="64" r={R} class="lu-ring__track" />
              <circle cx="64" cy="64" r={R} class="lu-ring__bar" style={`stroke-dasharray: ${C}; --c: ${C}`} />
            </svg>
            <span class="lu-ring__value"><span data-count={s.value}>{s.value}</span>%</span>
            <p>{s.label}</p>
            <p class="lu-ring__src" set:html={ph(s.source)} />
          </li>
        ))}
      </ul>
    </section>

    <!-- 7 · User flow, drawn live -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>User flow</p>
      <h2 class="cs-h2" data-reveal>{cs.flow.title}</h2>
      <p class="cs-lede" data-reveal>{cs.flow.text}</p>
      <figure class="lu-flow" data-reveal>
        <svg viewBox="0 0 1000 560" role="img" aria-label="User flow: Splash, Home, then Log In, Sign Up, Discover, Wishlist, Account and Shop. The try-on path runs Home, Shop, then Product Listing, AI Try-On, Product Detail and Cart & Checkout.">
          {E.map(([a, b, hot], k) => <path class:list={['lu-edge', hot && 'lu-edge--hot']} d={curve(a, b)} pathLength="1" style={`--k: ${k}`} />)}
          <path id="lu-travel" d={travel} fill="none" stroke="none" />
          <circle r="6" class="lu-dot"><animateMotion dur="2.8s" repeatCount="indefinite" rotate="auto"><mpath href="#lu-travel" /></animateMotion></circle>
          {Object.values(N).map((n, k) => {
            const w = n.t.length * 7.4 + 34;
            return (
              <g class:list={['lu-node', n.hot && 'lu-node--hot', n.key && 'lu-node--key']} style={`--k: ${k}`} transform={`translate(${n.x} ${n.y})`}>
                <rect x={-w / 2} y="-17" width={w} height="34" rx="17" />
                <text text-anchor="middle" dy="4.5">{n.t}</text>
              </g>
            );
          })}
        </svg>
        <figcaption class="lu-flow__key"><span class="lu-flow__swatch"></span> The try-on path: one tap from the product grid</figcaption>
      </figure>
    </section>

    <!-- 8 · Discover → Consider → Visualize (pinned) -->
    <section class="cs-decisions lu-steps" data-cs-decisions aria-labelledby="steps-title" style={`--steps: ${cs.steps.length}`}>
      <div class="cs-decisions__stage">
        <div class="cs-decisions__text">
          <p class="label cs-label">The experience</p>
          <h2 id="steps-title" class="cs-h2 cs-decisions__title">From browsing to seeing it on you</h2>
          <ol class="cs-dots" aria-hidden="true">{cs.steps.map((_, i) => <li data-dot>0{i + 1}</li>)}</ol>
          <div class="cs-steps-text">
            {cs.steps.map((s, i) => (
              <article class="cs-step" data-step>
                <h3 class="cs-h3"><span class="cs-num">0{i + 1}</span> {s.k}</h3>
                <p class="lu-step__text">{s.v}</p>
                {i === cs.steps.length - 1 && <p class="label lu-step__hint">Try it: the panel on the right is the live site’s, rebuilt</p>}
                <img class="lu-step__img" src={s.image} alt={`${s.k} screen`} loading="lazy" decoding="async" />
              </article>
            ))}
          </div>
        </div>
        <div class="cs-screen lu-screen" data-screen>
          {cs.steps.map((s, i) => (
            <div class="cs-layer" data-layer>
              {i < cs.steps.length - 1
                ? <img class="lu-phone" src={s.image} alt={`${s.k} screen`} loading="lazy" decoding="async" />
                : (
                  <div class="tryon" data-tryon>
                    <div class="tryon__panel">
                      <button class="tryon__x" type="button" aria-label="Close (demo)" tabindex="-1">×</button>
                      <p class="tryon__title">Virtual Try-On</p>
                      <p class="tryon__product">{cs.tryon.product}</p>
                      <div class="tryon__body">
                        <div>
                          <p class="tryon__label">For best results</p>
                          <ul class="tryon__tips">
                            {cs.tryon.tips.map((t, k) => (
                              <li style={`--k: ${k}`}>
                                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" pathLength="1" /></svg>{t}
                              </li>
                            ))}
                          </ul>
                        </div>
                        <div class="tryon__drop">
                          <svg viewBox="0 0 24 48" aria-hidden="true"><circle cx="12" cy="6" r="4.5" /><path d="M7 13h10l1.5 15h-3l-1 19h-5l-1-19h-3z" /></svg>
                          <p>Drag your photo here</p>
                          <p class="tryon__or">or</p>
                          <a class="tryon__btn" href="https://shop-luciana.co" target="_blank" rel="noopener">Choose Photo</a>
                          <p class="tryon__fine">JPEG or PNG · max 5MB</p>
                        </div>
                      </div>
                    </div>
                    <p class="tryon__live label">Rebuilt from shop-luciana.co · <a href="https://shop-luciana.co" target="_blank" rel="noopener">try it for real ↗</a></p>
                  </div>
                )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 9 · Typography & colour: a type tester and copyable swatches -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>Typography & colour</p>
      <h2 class="cs-h2" data-reveal>An editorial voice, an interface that stays out of the way</h2>
      <div class="lu-type">
        {cs.type.map((t) => (
          <div class="lu-spec" data-reveal data-spec style={`--ff: ${t.css}`}>
            <div class="lu-spec__head">
              <p class="label">{t.role}</p>
              <p class="lu-spec__name">{t.family}</p>
            </div>
            <p class="lu-spec__aa" data-spec-sample>Aa</p>
            <p class="lu-spec__line" data-spec-sample>Own your light.</p>
            <div class="lu-spec__weights" role="group" aria-label={`${t.family} weight`}>
              {[['Light', 300], ['Regular', 400], ['Medium', 500], ['SemiBold', 600], ['Bold', 700]].map(([n, w]) => (
                <button type="button" data-weight={w} aria-pressed={w === 400 ? 'true' : 'false'}>{n}</button>
              ))}
            </div>
            <p class="lu-spec__note">{t.v}</p>
          </div>
        ))}
      </div>
      <ul class="lu-swatches" aria-label="Colour palette">
        {cs.colours.map((c) => (
          <li data-reveal>
            <button type="button" class="lu-swatch" data-copy-hex={c.hex} style={`--sw: ${c.hex}`}>
              <span class="lu-swatch__chip"></span>
              <span class="lu-swatch__name">{c.name}</span>
              <span class="lu-swatch__hex" data-hex>{c.hex}</span>
            </button>
          </li>
        ))}
      </ul>
      <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
    </section>

    <!-- 10 · Outcome + closing line -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>The outcome</p>
      <ul class="cs-stats">
        <li class="cs-stat" data-reveal><span class="cs-stat__value">Live</span><span>shop-luciana.co, with try-on on product pages</span></li>
        <li class="cs-stat cs-stat--ph" data-reveal set:html={ph(cs.outcome)} />
      </ul>
      <p class="lu-quote lu-quote--close" data-words set:html={words(cs.closing)} />
    </section>

    <!-- 11 · Next -->
    <section class="cs-next">
      <p class="label">Next case study</p>
      <a class="cs-next__link" href="/work/praisetival">Praisetival Ireland <span aria-hidden="true">→</span></a>
      <div class="lu-next__row">
        <a class="label lu-next__all" href="/#product">All work</a>
        <button class="cs-next__talk label" type="button" data-contact-open>Let’s talk</button>
      </div>
    </section>
  </main>
  <ContactSheet />
</Base>

<style>
  .lu { --accent: #e3bd98; --hot: #ff5a1f; }

  /* 1 · opening: letters drift apart and fade, the monitor rises and settles under the title */
  .lu-intro { position: relative; height: 230vh; --p: 0; }
  .lu-intro__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; display: grid; place-items: center; }
  .lu-word { --e: clamp(0, var(--p) / 0.7, 1); position: absolute; inset: 0; display: flex; justify-content: center; align-items: center; margin: 0; font-family: 'Spectral', Georgia, serif; font-weight: 300; font-size: clamp(4rem, 19vw, 20rem); letter-spacing: 0.02em; color: rgba(208, 197, 171, 0.9); pointer-events: none; }
  .lu-word span { display: inline-block; translate: calc(var(--i) * var(--e) * 9vw) calc(var(--e) * -6vh); opacity: calc(1 - var(--e) * 0.88); }
  .lu-intro__device {
    --e: clamp(0, (var(--p) - 0.05) / 0.6, 1);
    position: absolute; left: 50%; bottom: 0;
    width: min(940px, 80vw, calc((100svh - 330px) * 1.57));
    height: auto;
    translate: -50% calc((1 - var(--e)) * 38svh);
    scale: calc(0.86 + var(--e) * 0.14);
    filter: drop-shadow(0 40px 80px rgba(0, 0, 0, 0.6));
  }
  .lu-intro__copy { --c: clamp(0, (var(--p) - 0.45) / 0.3, 1); position: absolute; left: 0; right: 0; top: 0; z-index: 1; padding: clamp(96px, 13svh, 140px) var(--pad) 0; opacity: var(--c); translate: 0 calc((1 - var(--c)) * 30px); }
  .lu-intro__title { margin: 14px 0 0; max-width: 30ch; font-family: 'Spectral', Georgia, serif; font-weight: 400; font-size: clamp(1.6rem, 0.9rem + 2vw, 2.9rem); line-height: 1.08; letter-spacing: -0.01em; text-wrap: balance; }
  .lu-intro__hint { position: absolute; left: 50%; bottom: 24px; translate: -50% 0; color: var(--fog); opacity: calc(1 - var(--p) * 6); }

  /* quote: lights up word by word */
  .lu-quote { max-width: 26ch; margin: clamp(24px, 4vw, 56px) 0 0; font-family: 'Spectral', Georgia, serif; font-style: italic; font-weight: 400; font-size: clamp(1.9rem, 1rem + 2.8vw, 3.6rem); line-height: 1.15; }
  .lu-quote--close { max-width: 30ch; margin-top: clamp(56px, 8vw, 120px); font-style: normal; }
  .lu-quote :global(.w) { opacity: var(--o, 1); transition: opacity 0.25s linear; }
  .lu-quote :global(.w--em) { color: var(--accent); }
  :global(html.js) .lu-quote :global(.w) { --o: 0.16; }

  /* solution: the phone floats */
  .lu-solution { grid-template-columns: 1fr 1fr; align-items: center; column-gap: clamp(32px, 5vw, 80px); }
  .lu-solution__text { display: grid; gap: clamp(20px, 2.4vw, 32px); }
  .lu-float { width: 100%; height: auto; animation: float 7s var(--ease-in-out) infinite alternate; }
  @keyframes float { to { translate: 0 -18px; rotate: -1.2deg; } }

  /* goals */
  .lu-goals { grid-template-columns: 1.1fr 0.9fr; align-items: center; column-gap: clamp(32px, 5vw, 80px); }
  .lu-goals > div { display: grid; gap: clamp(20px, 2.4vw, 32px); }
  .lu-goals__list { display: grid; gap: 20px; margin: 12px 0 0; padding: 0; list-style: none; }
  .lu-goals__list li { display: grid; gap: 6px; padding-bottom: 20px; border-bottom: 1px solid rgba(227, 189, 152, 0.4); }
  .lu-goals__list p { color: var(--dim); }
  .lu-goals__img { width: 100%; height: auto; border-radius: 18px; }

  /* research rings */
  .lu-rings { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 3vw, 48px); margin: 16px 0 0; padding: 0; list-style: none; }
  .lu-ring { position: relative; display: grid; justify-items: center; gap: 12px; text-align: center; }
  .lu-ring svg { width: clamp(150px, 15vw, 200px); rotate: -90deg; }
  .lu-ring circle { fill: none; stroke-width: 6; }
  .lu-ring__track { stroke: rgba(208, 197, 171, 0.1); }
  .lu-ring__bar { stroke: var(--accent); stroke-linecap: round; stroke-dashoffset: var(--c); transition: stroke-dashoffset 1.8s var(--ease-out) 0.2s; }
  .lu-ring:global(.is-in) .lu-ring__bar { stroke-dashoffset: calc(var(--c) * (1 - var(--v) / 100)); }
  .lu-ring__value { position: absolute; top: clamp(52px, 5.2vw, 70px); font-family: 'Spectral', Georgia, serif; font-size: clamp(2rem, 1.2rem + 1.8vw, 3rem); line-height: 1; }
  .lu-ring p { max-width: 30ch; color: var(--dim); line-height: 1.55; }
  .lu-ring__src { font-size: var(--type-small); }
  @media (max-width: 860px) { .lu-rings { grid-template-columns: 1fr; } }

  /* user flow: grey branches draw first, then the try-on path in orange; a dot travels it */
  .lu-flow { margin: 12px 0 0; padding: clamp(16px, 3vw, 40px); border-radius: 18px; background: var(--night-2); }
  .lu-flow svg { width: 100%; height: auto; overflow: visible; font-family: 'Montserrat', var(--font-sans); }
  .lu-edge { fill: none; stroke: rgba(208, 197, 171, 0.28); stroke-width: 1.5; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1s var(--ease-out); transition-delay: calc(var(--k) * 80ms); }
  .lu-edge--hot { stroke: var(--hot); stroke-width: 2.5; transition-duration: 1.2s; transition-delay: calc(1s + (var(--k) - 9) * 160ms); }
  .lu-flow:global(.is-in) .lu-edge { stroke-dashoffset: 0; }
  .lu-node { opacity: 0; transition: opacity 0.6s var(--ease-out); transition-delay: calc(var(--k) * 70ms); }
  .lu-flow:global(.is-in) .lu-node { opacity: 1; }
  .lu-node rect { fill: var(--night); stroke: rgba(208, 197, 171, 0.35); stroke-width: 1.2; }
  .lu-node text { fill: var(--fog); font-size: 12.5px; font-weight: 500; }
  .lu-node--hot rect { stroke: var(--hot); }
  .lu-node--key rect { fill: var(--hot); }
  .lu-node--key text { fill: #fff; font-weight: 600; }
  .lu-node--key { animation: pulse 2.4s var(--ease-in-out) infinite; transform-box: fill-box; }
  @keyframes pulse { 50% { filter: drop-shadow(0 0 10px rgba(255, 90, 31, 0.7)); } }
  .lu-dot { fill: #fff; opacity: 0; transition: opacity 0.6s 2.4s; }
  .lu-flow:global(.is-in) .lu-dot { opacity: 1; }
  .lu-flow__key { display: flex; align-items: center; gap: 10px; margin-top: 16px; color: var(--dim); font-size: var(--type-small); }
  .lu-flow__swatch { width: 24px; height: 3px; border-radius: 2px; background: var(--hot); }

  /* pinned steps: phones on a warm stage; the last step is the rebuilt try-on panel */
  .lu-screen { aspect-ratio: 4 / 3.4; background: radial-gradient(90% 80% at 50% 40%, #2a2420, var(--night-2)); }
  .lu-phone { position: absolute; inset: 6% 0; width: 100%; height: 88%; object-fit: contain; filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.55)); }
  .lu-step__text { color: var(--dim); line-height: 1.6; }
  .lu-step__img { display: none; }

  .tryon { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 14px; padding: 6%; background: rgba(20, 22, 24, 0.55); font-family: 'Montserrat', var(--font-sans); }
  .tryon__panel { position: relative; width: min(560px, 100%); padding: clamp(18px, 2.4vw, 28px); border-radius: 6px; background: #fff; color: #141618; box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.6); translate: 0 20px; opacity: 0; transition: translate 0.7s var(--ease-out) 0.15s, opacity 0.5s 0.15s; }
  .cs-layer:global(.is-on) .tryon__panel { translate: 0 0; opacity: 1; }
  .tryon__x { position: absolute; top: 10px; right: 14px; font-size: 20px; color: #5c6063; }
