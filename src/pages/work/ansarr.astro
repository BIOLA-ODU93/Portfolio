---
/**
 * Case study — Ansarr. Copy and images: src/content/work.ts (`ansarr`).
 * Interactions: the two apps part as you scroll (opening), a quote that lights
 * word by word, a Give / Seek toggle that mirrors the waitlist's own switch, a
 * working rebuild of the pricing calculator, a pinned study-to-payout scene, a
 * light/dark compare slider, and copyable colours.
 */
import Base from '../../layouts/Base.astro';
import ContactSheet from '../../components/ContactSheet.astro';
import { ansarr as cs } from '../../content/work';
import { site } from '../../content/site';
import '../../styles/case-study.css';

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const ph = (s: string) => esc(s).replace(/\[(.+?)\]/g, '<span class="ph">$1</span>');
/** words for the scroll reveal; *starred* runs become accent words */
const words = (s: string) => {
  let on = false;
  return s.split(/\s+/).map((w) => {
    if (w.startsWith('*')) on = true;
    const html = `<span class="w${on ? ' w--em' : ''}">${esc(w.replace(/\*/g, ''))}</span>`;
    if (/\*[.,]?$/.test(w)) on = false;
    return html;
  }).join(' ');
};
const A = '/images/work/ansarr/';
---

<Base title={`${cs.client} — case study · ${site.displayName}`} description={cs.summary}>
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" />
  <header class="cs-bar" data-cs-bar>
    <a class="cs-bar__logo" href="/"><img src="/brand/signature.png" alt={`${site.displayName} — home`} width="115" height="88" /></a>
    <a class="cs-bar__back label" href="/#product">← All work</a>
  </header>

  <main id="main" tabindex="-1" class="cs an" data-cs>
    <!-- 1 · Opening: the two apps part, the title arrives between them -->
    <section class="an-intro" data-cs-intro aria-labelledby="cs-title">
      <div class="an-intro__stage">
        <p class="an-word" aria-hidden="true">Ansarr</p>
        <figure class="an-intro__phone an-intro__phone--give">
          <div class="an-frame"><img src={A + 'welcome.webp'} alt="Give Ansarr welcome screen: Get paid for your point of view" width="390" height="844" fetchpriority="high" /></div>
          <figcaption class="label">Give Ansarr · respondents</figcaption>
        </figure>
        <figure class="an-intro__phone an-intro__phone--seek">
          <div class="an-frame"><img src={A + 'workspace.webp'} alt="Seek Ansarr researcher workspace" width="390" height="892" /></div>
          <figcaption class="label">Seek Ansarr · researchers</figcaption>
        </figure>
        <div class="an-intro__copy">
          <p class="label cs-kicker">{cs.kicker} · {cs.client}</p>
          <h1 id="cs-title" class="an-intro__title">{cs.title}</h1>
        </div>
        <p class="an-intro__hint label" aria-hidden="true">Scroll</p>
      </div>
    </section>

    <!-- 2 · At a glance -->
    <section class="cs-sec cs-glance">
      <p class="cs-summary" data-reveal>{cs.summary}</p>
      <dl class="cs-meta" data-reveal>
        {cs.meta.map((m) => <div><dt class="label">{m.k}</dt><dd>{m.href ? <a href={m.href} target="_blank" rel="noopener">{m.v} ↗</a> : m.v}</dd></div>)}
      </dl>
      <p class="label cs-label">At a glance</p>
      <div class="cs-cols">{cs.glance.map((g) => <div class="cs-col" data-reveal><h2 class="cs-h3">{g.k}</h2><p>{g.v}</p></div>)}</div>
    </section>

    <!-- 3 · Problem → the quote lights up word by word -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>The problem</p>
      <p class="cs-lede" data-reveal>{cs.problem.text}</p>
      <blockquote class="an-quote" data-words set:html={words(cs.problem.quote)} />
    </section>

    <!-- 4 · Two sides: a toggle like the waitlist's own -->
    <section class="cs-sec" data-sides>
      <p class="label cs-label" data-reveal>Two apps, one marketplace</p>
      <h2 class="an-h2" data-reveal>Every study has two people behind it</h2>
      <div class="an-toggle" role="tablist" aria-label="Choose a side" data-reveal>
        {cs.sides.map((s, i) => (
          <button role="tab" type="button" id={`tab-${s.id}`} aria-controls={`side-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-side={s.id}>{s.name}</button>
        ))}
        <span class="an-toggle__pill" aria-hidden="true"></span>
      </div>
      {cs.sides.map((s, i) => (
        <div class="an-side" id={`side-${s.id}`} role="tabpanel" aria-labelledby={`tab-${s.id}`} hidden={i !== 0} data-side-panel={s.id}>
          <div class="an-side__text">
            <p class="label">{s.who}</p>
            <p class="an-side__line">{s.line}</p>
            <ul class="an-side__jobs">{s.jobs.map((j) => <li>{j}</li>)}</ul>
          </div>
          <div class="an-side__phones">
            {s.screens.map(([src, alt], k) => <div class="an-frame" style={`--k: ${k}`}><img src={src} alt={alt} loading="lazy" decoding="async" /></div>)}
          </div>
        </div>
      ))}
    </section>

    <!-- 5 · Approach: honest about research; the rules became the brief -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>Approach</p>
      <h2 class="an-h2" data-reveal>{cs.approach.title}</h2>
      <p class="cs-lede" data-reveal>{cs.approach.text}</p>
      <ol class="an-rules">
        {cs.approach.rules.map((r, i) => <li data-reveal><span class="cs-num">0{i + 1}</span><h3 class="cs-h4">{r.k}</h3><p>{r.v}</p></li>)}
      </ol>
    </section>

    <!-- 6 · Pricing calculator, rebuilt and working -->
    <section class="cs-sec an-calc-sec">
      <div class="an-calc-sec__text">
        <p class="label cs-label" data-reveal>Rule 01, in practice</p>
        <h2 class="an-h2" data-reveal>Know the cost before you fund</h2>
        <p class="cs-lede" data-reveal>Researchers can price a study before they create it. Try it: this is a working rebuild of Ansarr’s calculator, using the live Level 1 rates (₦500 a minute, billed for at least 3 minutes).</p>
      </div>
      <form class="an-calc" data-calc data-reveal onsubmit="return false">
        <label class="an-calc__row">
          <span class="an-calc__k">Study length <output data-out="len">5 min</output></span>
          <input type="range" min="1" max="30" value="5" step="1" data-in="len" />
        </label>
        <label class="an-calc__row">
          <span class="an-calc__k">Responses <output data-out="n">100</output></span>
          <input type="range" min="10" max="500" value="100" step="10" data-in="n" />
        </label>
        <p class="an-calc__each">Each respondent earns <strong data-out="reward">₦2,500</strong></p>
        <dl class="an-calc__bill">
          <div><dt>Rewards (<span data-out="mult">₦2,500 × 100</span>)</dt><dd data-out="rewards">₦250,000</dd></div>
          <div><dt>Platform fee (15%)</dt><dd data-out="fee">₦37,500</dd></div>
          <div class="an-calc__total"><dt>Total to fund</dt><dd data-out="total">₦287,500</dd></div>
        </dl>
        <p class="an-calc__note">Estimate, as on ansarr.com. The fee isn’t refunded if a study closes early; unspent rewards are.</p>
      </form>
    </section>

    <!-- 7 · One study, from funding to payout (pinned) -->
    <section class="cs-decisions an-steps" data-cs-decisions aria-labelledby="steps-title" style={`--steps: ${cs.steps.length}`}>
      <div class="cs-decisions__stage">
        <div class="cs-decisions__text">
          <p class="label cs-label">The flow</p>
          <h2 id="steps-title" class="an-h2 cs-decisions__title">One study, from funding to payout</h2>
          <ol class="cs-dots an-dots" aria-hidden="true">{cs.steps.map((s) => <li data-dot>{s.k}</li>)}</ol>
          <div class="cs-steps-text">
            {cs.steps.map((s, i) => (
              <article class="cs-step" data-step>
                <h3 class="cs-h3"><span class="cs-num">0{i + 1}</span> {s.title}</h3>
                <p class="an-step__text">{s.v}</p>
                <div class="an-frame an-step__img"><img src={s.image} alt={`${s.k} screen`} loading="lazy" decoding="async" /></div>
              </article>
            ))}
          </div>
        </div>
        <div class="cs-screen an-screen" data-screen>
          {cs.steps.map((s, i) => (
            <div class="cs-layer" data-layer>
              <p class="an-screen__side label">{i < 2 ? 'Seek Ansarr · researcher' : 'Give Ansarr · respondent'}</p>
              <div class="an-frame an-screen__phone"><img src={s.image} alt={`${s.k} screen`} loading="lazy" decoding="async" /></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 8 · Verification -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>Verification</p>
      <h2 class="an-h2" data-reveal>{cs.verify.title}</h2>
      <p class="cs-lede" data-reveal>{cs.verify.text}</p>
      <ol class="an-levels">
        {cs.verify.screens.map(([src, k, v], i) => (
          <li data-reveal style={`--k: ${i}`}>
            <div class="an-frame"><img src={src} alt={`${k} screen`} loading="lazy" decoding="async" /></div>
            <p class="an-levels__k"><span class="cs-num">0{i + 1}</span>{k}</p>
            <p class="an-levels__v">{v}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- 9 · Design system: light/dark compare, type and copyable colours -->
    <section class="cs-sec an-system">
      <div class="an-system__text">
        <p class="label cs-label" data-reveal>Design system</p>
        <h2 class="an-h2" data-reveal>{cs.system.title}</h2>
        <p class="cs-lede" data-reveal>{cs.system.text}</p>
        <div class="an-spec" data-reveal>
          <p class="an-spec__aa">Aa</p>
          <div>
            <p class="an-spec__name">{cs.type.family}</p>
            <p class="an-spec__note">{cs.type.v}</p>
            <p class="an-spec__num">₦287,500</p>
          </div>
        </div>
      </div>
      <figure class="an-compare" data-compare data-reveal style="--x: 50%">
        <div class="an-frame an-compare__frame">
          <img src={A + 'feed.webp'} alt="Available studies, light theme" loading="lazy" decoding="async" />
          <img class="an-compare__dark" src={A + 'feed-dark.webp'} alt="The same screen in the dark theme" loading="lazy" decoding="async" />
          <span class="an-compare__line" aria-hidden="true"></span>
        </div>
        <input class="an-compare__range" type="range" min="0" max="100" value="50" aria-label="Compare light and dark themes" data-compare-range />
        <figcaption class="label">Drag to compare · light and dark, same tokens</figcaption>
      </figure>
      <ul class="an-swatches" aria-label="Colour palette">
        {cs.colours.map((c) => (
          <li data-reveal>
            <button type="button" class="an-swatch" data-copy-hex={c.hex} style={`--sw: ${c.hex}`}>
              <span class="an-swatch__chip"></span>
              <span class="an-swatch__name">{c.name}</span>
              <span class="an-swatch__hex" data-hex>{c.hex}</span>
            </button>
          </li>
        ))}
      </ul>
      <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
    </section>

    <!-- 10 · Launch timeline -->
    <section class="cs-sec an-launch">
      <div>
        <p class="label cs-label" data-reveal>Launch</p>
        <h2 class="an-h2" data-reveal>From waitlist to launch in three months</h2>
        <ol class="an-timeline">
          {cs.timeline.map((t) => <li data-reveal><p class="label">{t.when}</p><h3 class="cs-h4">{t.k}</h3><p>{t.v}</p></li>)}
        </ol>
        <a class="an-link label" href="/#graphic" data-reveal>See the launch campaign →</a>
      </div>
      <div class="an-frame an-launch__phone" data-reveal><img src={A + 'waitlist.webp'} alt="Waitlist page with a Seek Ansarr and Give Ansarr toggle" loading="lazy" decoding="async" /></div>
    </section>

    <!-- 11 · Outcome, what's next, closing line -->
    <section class="cs-sec">
      <p class="label cs-label" data-reveal>The outcome</p>
      <ul class="cs-stats">
        <li class="cs-stat" data-reveal><span class="cs-stat__value">3 <span class="cs-stat__unit">months</span></span><span>From the first screen to Android launch (Jun – Sep 2026)</span></li>
        <li class="cs-stat" data-reveal><span class="cs-stat__value">2</span><span>Apps, one design system, light and dark</span></li>
        {cs.outcome.map((o) => <li class="cs-stat cs-stat--ph" data-reveal set:html={ph(o)} />)}
      </ul>
      <p class="label cs-label an-next-label" data-reveal>What I’d do next</p>
      <p class="cs-lede" data-reveal>{cs.next}</p>
      <p class="an-quote an-quote--close" data-words set:html={words(cs.closing)} />
    </section>

    <!-- 12 · Next -->
    <section class="cs-next">
      <p class="label">Next case study</p>
      <a class="cs-next__link" href="/work/praisetival">Praisetival Ireland <span aria-hidden="true">→</span></a>
      <div class="an-next__row">
        <a class="label an-next__all" href="/#product">All work</a>
        <button class="cs-next__talk label" type="button" data-contact-open>Let’s talk</button>
      </div>
    </section>
  </main>
  <ContactSheet />
</Base>

<style>
  .an { --accent: #aa8bf8; --money: #57c087; --violet: #6935f0; }
  .an-h2 { margin: 0; max-width: 22ch; font-family: var(--font-display); font-weight: 500; font-size: clamp(1.8rem, 1rem + 2vw, 3rem); line-height: 1.08; letter-spacing: -0.03em; text-wrap: balance; }

  /* phone frame used everywhere: screens are 390 wide, cropped from the top */
  .an-frame { aspect-ratio: 390 / 844; padding: 8px; border-radius: 38px; background: #1b1f27; box-shadow: inset 0 0 0 1px rgba(208, 197, 171, 0.14), 0 40px 80px -30px rgba(0, 0, 0, 0.9); overflow: hidden; }
  .an-frame img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 30px; }

  /* 1 · opening: the two apps start stacked, then part to either side of the title */
  .an-intro { position: relative; height: 230vh; --p: 0; }
  .an-intro__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; display: grid; place-items: center; background: radial-gradient(60% 55% at 50% 60%, rgba(105, 53, 240, 0.28), transparent 70%); }
  .an-word { --e: clamp(0, var(--p) / 0.6, 1); position: absolute; margin: 0; font-family: 'Geist', var(--font-display); font-weight: 600; font-size: clamp(5rem, 22vw, 22rem); letter-spacing: -0.06em; color: rgba(208, 197, 171, 0.07); scale: calc(1 + var(--e) * 0.15); opacity: calc(1 - var(--e) * 0.5); pointer-events: none; }
  .an-intro__phone { --e: clamp(0, (var(--p) - 0.05) / 0.55, 1); position: absolute; top: 50%; left: 50%; margin: 0; display: grid; gap: 14px; justify-items: center; --w: min(250px, 22vw, calc((100svh - 220px) * 0.46)); --spread: calc(15vw + var(--w) / 2 + 28px); width: var(--w); }
  .an-intro__phone figcaption { opacity: var(--e); color: var(--accent); white-space: nowrap; }
  .an-intro__phone--give { z-index: 1; translate: calc(-50% - var(--e) * var(--spread)) calc(-50% + (1 - var(--e)) * 2svh); rotate: calc(var(--e) * -4deg); }
  .an-intro__phone--seek { translate: calc(-50% + var(--e) * var(--spread) + (1 - var(--e)) * 40px) calc(-50% + (1 - var(--e)) * 5svh); rotate: calc(var(--e) * 4deg + (1 - var(--e)) * 6deg); }
  .an-intro__copy { --c: clamp(0, (var(--p) - 0.35) / 0.3, 1); position: relative; z-index: 2; max-width: min(34ch, 30vw); text-align: center; opacity: var(--c); translate: 0 calc((1 - var(--c)) * 30px); }
  .an-intro__title { margin: 14px 0 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(1.5rem, 0.9rem + 1.8vw, 2.7rem); line-height: 1.08; letter-spacing: -0.03em; text-wrap: balance; }
  .an-intro__hint { position: absolute; left: 50%; bottom: 24px; translate: -50% 0; color: var(--fog); opacity: calc(1 - var(--p) * 6); }
  @media (max-width: 760px) {
    .an-intro__phone { width: min(180px, 40vw); top: 64%; }
    .an-intro__phone--give { translate: calc(-50% - var(--e) * 26vw) -50%; }
    .an-intro__phone--seek { translate: calc(-50% + var(--e) * 26vw) -50%; }
    .an-intro__phone figcaption { display: none; }
    .an-intro__copy { position: absolute; top: clamp(90px, 14svh, 130px); max-width: none; padding: 0 var(--pad); }
  }

  /* quote: lights up word by word */
  .an-quote { max-width: 24ch; margin: clamp(24px, 4vw, 56px) 0 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(1.9rem, 1rem + 2.8vw, 3.6rem); line-height: 1.1; letter-spacing: -0.03em; }
  .an-quote--close { max-width: 26ch; margin-top: clamp(56px, 8vw, 120px); }
  .an-quote :global(.w) { opacity: var(--o, 1); transition: opacity 0.25s linear; }
  .an-quote :global(.w--em) { color: var(--accent); }
  :global(html.js) .an-quote :global(.w) { --o: 0.16; }

  /* two sides: segmented toggle like the waitlist page */
  .an-toggle { position: relative; display: inline-grid; grid-template-columns: 1fr 1fr; justify-self: start; padding: 5px; border-radius: 999px; background: var(--night-2); outline: 1px solid var(--line); }
  .an-toggle button { position: relative; z-index: 1; padding: 12px 22px; border-radius: 999px; font-weight: 500; color: var(--dim); transition: color 0.4s; }
  .an-toggle button[aria-selected='true'] { color: #fff; }
  .an-toggle__pill { position: absolute; top: 5px; bottom: 5px; left: 5px; width: calc(50% - 5px); border-radius: 999px; background: var(--violet); transition: translate 0.5s var(--ease-out); }
  .an-toggle[data-on='seek'] .an-toggle__pill { translate: 100% 0; }
  .an-side { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(24px, 4vw, 64px); align-items: center; margin-top: 12px; }
  .an-side[hidden] { display: none; }
  .an-side__text { display: grid; gap: 16px; }
  .an-side__line { margin: 0; font-family: var(--font-display); font-size: var(--fs-2); line-height: 1.25; letter-spacing: -0.02em; }
  .an-side__jobs { display: grid; gap: 12px; margin: 8px 0 0; padding: 0; list-style: none; color: var(--dim); }
  .an-side__jobs li { padding-left: 26px; position: relative; line-height: 1.5; }
  .an-side__jobs li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 12px; height: 2px; background: var(--accent); }
  .an-side__phones { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(12px, 2vw, 28px); }
  .an-side__phones .an-frame { animation: side-in 0.7s var(--ease-out) both; animation-delay: calc(var(--k) * 90ms); }
  .an-side__phones .an-frame:nth-child(2) { translate: 0 -24px; }
  @keyframes side-in { from { opacity: 0; transform: translateY(24px); } }
  @media (max-width: 860px) { .an-side { grid-template-columns: 1fr; } .an-side__phones { grid-template-columns: repeat(3, minmax(0, 1fr)); } .an-frame { padding: 5px; border-radius: 24px; } .an-frame img { border-radius: 19px; } }

  /* rules */
  .an-rules { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin: 12px 0 0; padding: 0; list-style: none; }
  .an-rules li { display: grid; gap: 8px; align-content: start; padding: 24px; border-radius: 14px; background: var(--night-2); }
  .an-rules p { color: var(--dim); line-height: 1.55; }

  /* calculator */
  .an-calc-sec { grid-template-columns: 1fr 1fr; align-items: center; column-gap: clamp(32px, 5vw, 80px); }
  .an-calc-sec__text { display: grid; gap: clamp(20px, 2.4vw, 32px); }
  .an-calc { display: grid; gap: 22px; padding: clamp(22px, 3vw, 36px); border-radius: 20px; background: #f6f7f9; color: #171b23; font-family: 'Geist', var(--font-sans); box-shadow: 0 40px 100px -40px rgba(105, 53, 240, 0.55); }
  .an-calc__row { display: grid; gap: 10px; }
  .an-calc__k { display: flex; justify-content: space-between; font-size: 14px; font-weight: 500; color: #4e5666; }
  .an-calc__k output { color: #171b23; font-weight: 600; font-variant-numeric: tabular-nums; }
  .an-calc input[type='range'] { width: 100%; accent-color: var(--violet); }
  .an-calc__each { margin: 0; padding: 14px 16px; border-radius: 12px; background: #e7f6ee; color: #0c5a34; font-size: 15px; }
  .an-calc__each strong { font-size: 1.25em; font-variant-numeric: tabular-nums; }
  .an-calc__bill { display: grid; gap: 10px; margin: 0; padding: 16px; border-radius: 12px; background: #fff; font-size: 14px; }
  .an-calc__bill div { display: flex; justify-content: space-between; gap: 12px; }
  .an-calc__bill dt { color: #6c7484; }
  .an-calc__bill dd { margin: 0; font-weight: 500; font-variant-numeric: tabular-nums; }
  .an-calc__total { padding-top: 10px; border-top: 1px solid #e0e4ea; font-size: 16px; }
  .an-calc__total dt { color: #171b23; font-weight: 600; }
  .an-calc__total dd { font-weight: 700; color: var(--violet); }
  .an-calc__note { margin: 0; font-size: 12px; color: #6c7484; line-height: 1.5; }
  .an-calc [data-out] { transition: color 0.3s; }
  @media (max-width: 860px) { .an-calc-sec { grid-template-columns: 1fr; } }

  /* pinned flow */
  .an-dots li { font-size: 11.5px; }
  .an-dots li:global(.is-on) { background: var(--violet); color: #fff; border-color: var(--violet); }
  .an-step__text { color: var(--dim); line-height: 1.6; }
  .an-step__img { display: none; }
  .an-screen { aspect-ratio: 4 / 3.6; background: radial-gradient(70% 70% at 50% 45%, rgba(105, 53, 240, 0.3), var(--night-2)); }
  .an-screen__phone { position: absolute; left: 50%; top: 9%; height: 84%; aspect-ratio: 390 / 844; translate: -50% calc((1 - var(--t)) * 14px); }
  .an-screen__side { position: absolute; left: 0; right: 0; top: 3.2%; margin: 0; text-align: center; color: var(--accent); }
  @media (max-width: 900px) { .an-step__img { display: block; width: min(260px, 70%); margin: 8px auto 0; } }

  /* verification ladder: each step rises a little higher */
  .an-levels { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 3vw, 48px); margin: 16px 0 0; padding: 0; list-style: none; align-items: end; }
  .an-levels li { display: grid; gap: 10px; align-content: end; translate: 0 calc(var(--k) * -28px); }
  .an-levels .an-frame { width: min(100%, 230px); }
  .an-levels__k { margin: 8px 0 0; font-weight: 500; }
  .an-levels__v { margin: 0; color: var(--dim); font-size: var(--type-small); line-height: 1.55; }
  @media (max-width: 760px) { .an-levels { grid-template-columns: 1fr; } .an-levels li { translate: none; } .an-levels .an-frame { width: min(240px, 70%); } }

  /* design system */
  .an-system { grid-template-columns: 1.1fr 0.9fr; column-gap: clamp(32px, 5vw, 80px); align-items: center; }
  .an-system__text { display: grid; gap: clamp(20px, 2.4vw, 32px); }
  .an-spec { display: grid; grid-template-columns: auto 1fr; gap: 24px; align-items: center; padding: clamp(20px, 2.6vw, 32px); border-radius: 16px; background: var(--night-2); font-family: 'Geist', var(--font-sans); }
  .an-spec__aa { margin: 0; font-size: clamp(4.5rem, 3rem + 4vw, 7.5rem); font-weight: 600; line-height: 1; letter-spacing: -0.04em; color: var(--accent); }
  .an-spec__name { margin: 0; font-size: var(--fs-2); font-weight: 600; }
  .an-spec__note { margin: 6px 0 0; color: var(--dim); font-size: var(--type-small); line-height: 1.55; }
  .an-spec__num { margin: 12px 0 0; font-size: var(--fs-2); font-weight: 600; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--money); }
  .an-compare { position: relative; display: grid; gap: 14px; justify-items: center; margin: 0; }
  .an-compare__frame { position: relative; width: min(320px, 80%); }
  .an-compare__frame img { position: absolute; inset: 8px; width: calc(100% - 16px); height: calc(100% - 16px); }
  .an-compare__dark { clip-path: inset(0 0 0 var(--x)); }
  .an-compare__line { position: absolute; top: 0; bottom: 0; left: var(--x); width: 2px; background: var(--accent); box-shadow: 0 0 12px var(--accent); }
  .an-compare__range { position: absolute; inset: 0 0 32px; width: 100%; height: calc(100% - 32px); opacity: 0; cursor: ew-resize; }
  .an-compare__range:focus-visible + figcaption { outline: 2px solid var(--accent); outline-offset: 6px; }
  .an-compare figcaption { color: var(--dim); }
  .an-swatches { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; margin: 16px 0 0; padding: 0; list-style: none; }
  .an-swatch { display: grid; gap: 6px; width: 100%; text-align: left; }
  .an-swatch__chip { aspect-ratio: 1.4; border-radius: 12px; background: var(--sw); outline: 1px solid rgba(208, 197, 171, 0.12); transition: translate 0.4s var(--ease-out); }
  .an-swatch:hover .an-swatch__chip { translate: 0 -4px; }
  .an-swatch__name { font-weight: 500; }
  .an-swatch__hex { color: var(--dim); font-size: var(--type-small); font-variant-numeric: tabular-nums; }
  @media (max-width: 860px) { .an-system { grid-template-columns: 1fr; } .an-swatches { grid-template-columns: repeat(3, 1fr); } }

  /* launch */
  .an-launch { grid-template-columns: 1.2fr 0.8fr; column-gap: clamp(32px, 5vw, 80px); align-items: center; }
  .an-launch > div:first-child { display: grid; gap: clamp(20px, 2.4vw, 32px); }
  .an-timeline { display: grid; gap: 0; margin: 8px 0 0; padding: 0; list-style: none; border-left: 1px solid rgba(170, 139, 248, 0.4); }
  .an-timeline li { position: relative; display: grid; gap: 6px; padding: 0 0 26px 26px; }
  .an-timeline li::before { content: ''; position: absolute; left: -5px; top: 4px; width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }
  .an-timeline li:last-child::before { background: var(--money); box-shadow: 0 0 0 6px rgba(87, 192, 135, 0.18); }
  .an-timeline li p:not(.label) { color: var(--dim); line-height: 1.55; }
  .an-timeline .label { color: var(--accent); }
  .an-link { justify-self: start; color: var(--fog); padding: 12px 18px; border: 1px solid rgba(208, 197, 171, 0.3); border-radius: 999px; transition: background 0.3s, color 0.3s; }
  .an-link:hover { background: var(--fog); color: var(--night); }
  .an-launch__phone { width: min(300px, 100%); justify-self: center; }
  @media (max-width: 860px) { .an-launch { grid-template-columns: 1fr; } .an-launch__phone { width: min(240px, 70%); } }

  .an-next-label { margin-top: clamp(32px, 4vw, 56px); }
  .an-next__row { display: flex; gap: 16px; align-items: center; }
  .an-next__all { color: var(--fog); padding: 14px 20px; border: 1px solid rgba(208, 197, 171, 0.3); border-radius: 999px; }

  @media (prefers-reduced-motion: reduce) {
    .an-intro { height: auto; --p: 1; }
    .an-intro__stage { position: relative; height: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; padding: 120px var(--pad) 40px; }
    .an-word, .an-intro__hint { display: none; }
    .an-intro__copy { order: -1; flex-basis: 100%; max-width: none; }
    .an-intro__phone { position: relative; top: auto; left: auto; translate: none; rotate: none; }
    :global(html.js) .an-quote :global(.w) { --o: 1; }
    .an-side__phones .an-frame { animation: none; }
    .an-step__img { display: block; width: min(260px, 70%); margin: 8px auto 0; }
  }
</style>

<script>
  import { initCaseStudy } from '../../scripts/case-study';
  initCaseStudy();

  // Give / Seek toggle (tabs with arrow keys)
  const sides = document.querySelector<HTMLElement>('[data-sides]');
  if (sides) {
    const toggle = sides.querySelector<HTMLElement>('.an-toggle')!;
    const tabs = Array.from(sides.querySelectorAll<HTMLButtonElement>('[data-side]'));
    const pick = (b: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => { const on = t === b; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
      sides.querySelectorAll<HTMLElement>('[data-side-panel]').forEach((p) => { p.hidden = p.dataset.sidePanel !== b.dataset.side; });
      toggle.dataset.on = b.dataset.side;
      if (focus) b.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(t));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); pick(tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length], true); }
      });
    });
  }

  // pricing calculator: Level 1 rates from ansarr.com (₦500/min, billed for at least 3 min), 15% fee
  const calc = document.querySelector<HTMLFormElement>('[data-calc]');
  if (calc) {
    const naira = (n: number) => '₦' + Math.round(n).toLocaleString('en-NG');
    const inp = (k: string) => calc.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!;
    const out = (k: string, v: string) => calc.querySelectorAll(`[data-out="${k}"]`).forEach((el) => { el.textContent = v; });
    const run = () => {
      const len = Number(inp('len').value), n = Number(inp('n').value);
      const reward = 500 * Math.max(len, 3), rewards = reward * n, fee = rewards * 0.15;
      out('len', `${len} min`); out('n', String(n)); out('reward', naira(reward));
      out('mult', `${naira(reward)} × ${n}`); out('rewards', naira(rewards)); out('fee', naira(fee)); out('total', naira(rewards + fee));
    };
    calc.addEventListener('input', run);
    run();
  }

  // light / dark compare
  const cmp = document.querySelector<HTMLElement>('[data-compare]');
  const range = cmp?.querySelector<HTMLInputElement>('[data-compare-range]');
  if (cmp && range) range.addEventListener('input', () => cmp.style.setProperty('--x', `${range.value}%`));
</script>
